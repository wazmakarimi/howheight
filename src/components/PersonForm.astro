---
import { PRESET_COLORS, CATEGORY_DEFINITIONS } from '../lib/constants';
import { ASSET_REGISTRY, CATEGORY_COUNTS, SEARCHABLE_ASSETS } from '../data/assetRegistry';
import { t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const initialStaticAssets = ASSET_REGISTRY.filter((a) => a.searchable).slice(0, 4);
---

<div id="person-form-card" class="bg-white rounded-2xl border border-slate-200/80 shadow-soft p-3.5 sm:p-4 space-y-3.5">
  <!-- Card Header -->
  <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <div id="form-icon-container" class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </div>
      <div class="min-w-0">
        <h2 id="form-title" class="font-bold text-slate-900 text-sm leading-tight truncate">{t(locale, 'sidebar.assetLibrary')}</h2>
        <p id="form-subtitle" class="text-[11px] text-slate-500 truncate">1,400+ figures + Custom Image</p>
      </div>
    </div>
  </div>

  <!-- Upload Custom Image Button & Hidden Input -->
  <div>
    <input 
      type="file" 
      id="custom-image-file-input" 
      accept="image/png,image/jpeg,image/webp,image/svg+xml" 
      class="hidden" 
    />
    <button
      type="button"
      id="upload-custom-image-btn"
      class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-soft-sm hover:shadow-soft transition-all active:scale-[0.98]"
      title="Upload your own photo or custom silhouette to compare"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <span>{t(locale, 'canvas.uploadCustom')}</span>
    </button>
  </div>

  <!-- Search Input Across All Assets -->
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <input
      type="text"
      id="asset-search-input"
      placeholder={t(locale, 'search.placeholder')}
      class="w-full pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all"
    />
  </div>

  <!-- 8 Category Navigation Tabs + All with Dynamic Counts -->
  <div>
    <div class="flex items-center justify-between mb-1">
      <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">
        {t(locale, 'nav.categoriesHeader')}
      </label>
      <span id="asset-count-badge" class="text-[10px] font-bold text-brand-600 bg-brand-50 px-1.5 py-0.2 rounded-full">
        {SEARCHABLE_ASSETS}
      </span>
    </div>

    <!-- Compact Category Grid -->
    <div class="grid grid-cols-2 gap-1 p-1 bg-slate-100/80 rounded-xl" id="category-filter-bar" role="tablist">
      <button
        type="button"
        class="category-tab-btn col-span-2 flex items-center justify-between px-2 py-1 rounded-lg text-[11px] font-bold transition-all text-left bg-white text-brand-600 shadow-soft-sm"
        data-category="all"
      >
        <span class="flex items-center gap-1.5 truncate">
          <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="truncate">{t(locale, 'sidebar.allCategories')}</span>
        </span>
        <span class="text-[10px] font-semibold text-brand-700 ml-1">{SEARCHABLE_ASSETS}</span>
      </button>
      {CATEGORY_DEFINITIONS.map((cat) => {
        const count = CATEGORY_COUNTS[cat.id as keyof typeof CATEGORY_COUNTS] || 0;
        return (
          <button
            type="button"
            class="category-tab-btn flex items-center justify-between px-2 py-1 rounded-lg text-[11px] font-semibold transition-all text-slate-600 hover:text-slate-900 hover:bg-white/60"
            data-category={cat.id}
          >
            <span class="truncate">{cat.label}</span>
            <span class="text-[10px] text-slate-400 font-medium ml-0.5">{count}</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Asset Thumbnail Grid with One-Click Add -->
  <div>
    <div class="flex items-center justify-between mb-1">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-600">
        {t(locale, 'action.add')}
      </span>
      <span class="text-[9px] text-slate-400 font-medium">Auto scales</span>
    </div>
    
    <div 
      id="asset-library-grid" 
      class="grid grid-cols-2 gap-1.5 max-h-[290px] overflow-y-auto p-1 border border-slate-200/80 rounded-xl bg-slate-50/50 scrollbar-thin"
    >
      {initialStaticAssets.map((asset) => (
        <button
          type="button"
          class="asset-grid-card group flex flex-col items-center justify-between p-1.5 rounded-lg bg-white border border-slate-200/80 hover:border-brand-500 hover:shadow-soft-sm hover:scale-[1.02] transition-all text-center cursor-pointer select-none"
          data-asset-id={asset.id}
          data-category={asset.category}
          data-name={asset.name}
          data-height={asset.heightCm || ''}
          data-status={asset.status}
          data-tags={asset.tags.join(',')}
          data-aliases={asset.aliases.join(',')}
          data-path={asset.publicPath}
          data-viewbox={asset.viewBox}
          data-anchor={asset.measurementAnchor ? `${asset.measurementAnchor.groundY},${asset.measurementAnchor.measurementY}` : ''}
          data-is-png={Boolean(asset.filename?.endsWith('.png') || asset.publicPath?.endsWith('.png')) ? 'true' : 'false'}
          title={asset.status === 'verified' && asset.heightCm 
            ? `Click to add ${asset.name} (${asset.heightCm} cm)` 
            : `Click to add ${asset.name} (Needs review / Height unavailable)`}
        >
          <!-- SVG Thumbnail via lazy-loaded img -->
          <div class="w-full h-14 flex items-end justify-center py-0.5 overflow-hidden pointer-events-none relative">
            <img
              src={asset.publicPath}
              alt={asset.name}
              loading="lazy"
              decoding="async"
              class="max-h-full max-w-full object-contain pointer-events-none filter drop-shadow-sm group-hover:scale-105 transition-transform"
            />
            {asset.status !== 'verified' && (
              <span class="absolute top-0.5 right-0.5 text-[8px] font-bold text-amber-700 bg-amber-100/90 px-1 py-0.2 rounded leading-tight">
                Review
              </span>
            )}
          </div>
          <!-- Label & Height Info -->
          <div class="w-full mt-1 pt-0.5 border-t border-slate-100 flex flex-col items-center">
            <span class="text-[10px] font-bold text-slate-900 group-hover:text-brand-600 truncate w-full" title={asset.name}>
              {asset.name}
            </span>
            {asset.status === 'verified' && asset.heightCm ? (
              <span class="text-[9px] font-semibold text-slate-500">
                {asset.heightCm} cm
              </span>
            ) : (
              <span class="text-[8.5px] font-medium text-slate-400 truncate">
                Height unavailable
              </span>
            )}
          </div>
        </button>
      ))}
    </div>
    <p id="no-assets-msg" class="hidden text-xs text-center py-4 text-slate-400 font-medium">
      No assets found matching your search.
    </p>
  </div>

  <!-- Entity Edit Inspector Panel (shown when an item is selected or editing) -->
  <div id="entity-edit-panel" class="pt-4 border-t border-slate-200/80 space-y-3.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
        <span id="edit-panel-title">Selected Entity Controls</span>
      </span>
      <button 
        type="button" 
        id="deselect-entity-btn" 
        class="text-[11px] font-semibold text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded transition-colors"
      >
        Done
      </button>
    </div>

    <!-- Edit Name -->
    <div>
      <label for="edit-entity-name" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">
        Label / Name
      </label>
      <input
        type="text"
        id="edit-entity-name"
        maxlength="40"
        class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
        placeholder="Name"
      />
    </div>

    <!-- Edit Height with Unit Toggle -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600">
          Physical Height
        </label>
        <div class="flex items-center bg-slate-100 p-0.5 rounded text-[10px] font-semibold" role="tablist">
          <button type="button" id="unit-tab-ft" class="px-2 py-0.5 rounded font-bold text-brand-600 bg-white shadow-soft-sm" data-unit="ft">
            ft / in
          </button>
          <button type="button" id="unit-tab-cm" class="px-2 py-0.5 rounded text-slate-600 hover:text-slate-900" data-unit="cm">
            cm
          </button>
        </div>
      </div>

      <!-- Cm Mode Input -->
      <div id="edit-height-cm-group" class="flex items-center gap-2">
        <input
          type="number"
          id="edit-height-cm-input"
          min="10"
          max="3000"
          step="1"
          class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
        />
        <span class="text-xs font-bold text-slate-500">cm</span>
      </div>

      <!-- Ft Mode Input (hidden when cm) -->
      <div id="edit-height-ft-group" class="hidden grid-cols-2 gap-2">
        <div class="flex items-center gap-1">
          <input
            type="number"
            id="edit-height-feet-input"
            min="0"
            max="99"
            class="w-full px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
            placeholder="5"
          />
          <span class="text-xs font-bold text-slate-500">ft</span>
        </div>
        <div class="flex items-center gap-1">
          <input
            type="number"
            id="edit-height-inches-input"
            min="0"
            max="11.9"
            step="0.1"
            class="w-full px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all"
            placeholder="10"
          />
          <span class="text-xs font-bold text-slate-500">in</span>
        </div>
      </div>

      <!-- Slider for fine height adjustment -->
      <div class="mt-2 flex items-center gap-2">
        <input
          type="range"
          id="edit-height-slider"
          min="15"
          max="500"
          step="1"
          class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-brand-600"
        />
      </div>
    </div>

    <!-- Color Chips -->
    <div>
      <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">
        Silhouette Color
      </label>
      <div class="flex flex-wrap gap-1.5" id="color-picker-chips">
        {PRESET_COLORS.map((col, idx) => (
          <button
            type="button"
            class="w-6 h-6 rounded-full border-2 border-white shadow-soft-sm hover:scale-110 transition-transform focus:outline-none color-chip-btn"
            style={`background-color: ${col.value};`}
            data-color={col.value}
            title={col.name}
          />
        ))}
      </div>
    </div>

    <!-- Opacity Slider -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <label for="edit-opacity-slider" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600">
          Opacity
        </label>
        <span id="opacity-val-label" class="text-[10px] font-bold text-slate-500">100%</span>
      </div>
      <input
        type="range"
        id="edit-opacity-slider"
        min="0.2"
        max="1.0"
        step="0.05"
        value="1.0"
        class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-brand-600"
      />
    </div>

    <!-- Action Buttons: Duplicate & Delete -->
    <div class="flex items-center gap-2 pt-2">
      <button
        type="button"
        id="duplicate-entity-btn"
        class="flex-1 py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        Duplicate
      </button>
      <button
        type="button"
        id="delete-entity-btn"
        class="py-1.5 px-3 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        Delete
      </button>
    </div>
  </div>

  <!-- Custom Image Upload Confirmation Dialog -->
  <div 
    id="custom-image-modal" 
    class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn"
    role="dialog"
    aria-modal="true"
    aria-labelledby="custom-modal-title"
  >
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-sm w-full p-5 space-y-4 animate-scaleUp">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 id="custom-modal-title" class="font-extrabold text-slate-900 text-sm flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          Add Custom Figure
        </h3>
        <button type="button" id="close-custom-modal-btn" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg text-sm font-bold">✕</button>
      </div>

      <!-- Preview -->
      <div class="flex flex-col items-center justify-center p-3 bg-slate-50 border border-dashed border-slate-200 rounded-xl">
        <img id="custom-modal-preview-img" src="" alt="Preview" class="max-h-36 object-contain rounded-lg shadow-sm" />
        <span id="custom-modal-aspect-hint" class="text-[10px] text-slate-400 mt-1.5 font-medium">Aspect ratio detected</span>
      </div>

      <!-- Form Inputs -->
      <div class="space-y-3">
        <div>
          <label for="custom-modal-name" class="block text-[11px] font-bold text-slate-700 mb-1">Figure Label / Name</label>
          <input 
            type="text" 
            id="custom-modal-name" 
            placeholder="e.g. My Photo" 
            maxlength="40"
            class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
        </div>

        <div>
          <label for="custom-modal-height" class="block text-[11px] font-bold text-slate-700 mb-1">Physical Height (cm)</label>
          <div class="flex items-center gap-2">
            <input 
              type="number" 
              id="custom-modal-height" 
              value="170" 
              min="10" 
              max="3000" 
              step="1"
              class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500"
            />
            <span class="text-xs font-bold text-slate-500">cm</span>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1">Label Color Accent</label>
          <div class="flex flex-wrap gap-1.5" id="custom-modal-color-chips">
            {PRESET_COLORS.slice(0, 8).map((col) => (
              <button
                type="button"
                class="w-6 h-6 rounded-full border-2 border-white shadow-soft-sm hover:scale-110 transition-transform custom-modal-color-btn"
                style={`background-color: ${col.value};`}
                data-color={col.value}
                title={col.name}
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2 pt-2">
        <button
          type="button"
          id="cancel-custom-modal-btn"
          class="flex-1 py-2 px-3 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-custom-modal-btn"
          class="flex-1 py-2 px-3 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-soft-sm transition-colors"
        >
          Add to Canvas
        </button>
      </div>
    </div>
  </div>
</div>
