---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQSection from '../../components/seo/FAQSection.astro';
import CategoryIcon from '../../components/brand/CategoryIcon.astro';
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../data/categories';
import { getLocalizedPath, t } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath('/height-comparison-chart/', locale)}`;

// Conversion chart dataset from 140 cm (4'7") to 215 cm (7'0.7")
const chartRows = [];
for (let cm = 140; cm <= 215; cm += 2) {
  const totalInches = cm / 2.54;
  const feet = Math.floor(totalInches / 12);
  const inches = (totalInches % 12).toFixed(1);
  const formatted = `${feet}' ${inches}"`;
  const exactMeters = (cm / 100).toFixed(2);
  
  let note = '';
  if (cm === 162) note = 'Global Adult Female Median';
  else if (cm === 170) note = 'Common Hollywood Actor Stature';
  else if (cm === 175) note = 'Global Adult Male Median';
  else if (cm === 178) note = 'US / European Adult Male Median';
  else if (cm === 183) note = '6\'0" Benchmark (Tall Stature)';
  else if (cm === 188) note = 'Athletic Forward Stature (6\'2")';
  else if (cm === 198) note = 'Michael Jordan / NBA Shooting Guard';
  else if (cm === 210) note = 'Architectural Standard Interior Door';

  chartRows.push({ cm, meters: exactMeters, feet, inches, formatted, note });
}

const faqs = [
  {
    question: 'How do I convert centimeters to feet and inches accurately?',
    answer: 'Divide the number of centimeters by 2.54 to get total inches. Then divide total inches by 12 to find whole feet. The remainder is inches. Example: 178 cm / 2.54 = 70.07 inches = 5 feet 10.1 inches.',
  },
  {
    question: 'What is the global average height for men and women?',
    answer: 'According to NCD Risk Factor Collaboration and anthropometric surveys, the worldwide adult average is ~175 cm (5\'9") for men and ~162 cm (5\'4") for women.',
  },
  {
    question: 'What height is considered "tall" worldwide?',
    answer: 'Globally, a stature of 183 cm (6 ft 0 in) or higher places an adult male in the top 15% of global height. For adult females, 170 cm (5 ft 7 in) or higher is considered tall.',
  },
  {
    question: 'Can I visualize any row of this height chart on the comparison tool?',
    answer: 'Yes! Click "Compare" beside any height benchmark in the table to open it directly in the HowHeight visual workspace.',
  },
];
---

<Layout
  title={`Height Comparison Chart | ${SITE.name}`}
  description="Comprehensive height comparison conversion chart comparing centimeters, feet, inches, meters, and benchmark anthropometric statures."
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: 'Height Comparison Chart', url: '/height-comparison-chart/' },
      ]}
    />

    <!-- Header -->
    <header class="text-center my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 mb-3 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span>Standard Metric &amp; Imperial Stature Guide</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Height Comparison Chart
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed max-w-3xl mx-auto">
        Search, convert, and compare standard stature benchmarks in centimeters, meters, and feet/inches with direct visual comparison links.
      </p>
    </header>

    <!-- Category Shortcuts -->
    <div class="mb-10 p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-3">
        Jump to Category Height Directories
      </span>
      <div class="flex flex-wrap gap-2">
        {CATEGORIES.map((c) => (
          <a
            href={c.route}
            class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-brand-50 hover:text-brand-600 text-xs font-semibold text-slate-700 transition-colors flex items-center gap-1.5 group"
          >
            <CategoryIcon categoryId={c.id} className="w-3.5 h-3.5 text-slate-500 group-hover:text-brand-600" />
            <span>{c.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Interactive Height Search / Filter -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-soft p-6 sm:p-8 mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            Centimeters to Feet &amp; Inches Conversion Matrix
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Displaying full range from 140 cm (4'7") to 215 cm (7'0.7")
          </p>
        </div>
        <div class="w-full sm:w-64">
          <label for="chart-search" class="sr-only">Search height</label>
          <input
            type="text"
            id="chart-search"
            placeholder="Filter by cm or feet (e.g. 175, 5'10)..."
            class="w-full px-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none"
          />
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto max-h-[650px] overflow-y-auto border border-slate-200 rounded-2xl">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead class="sticky top-0 bg-slate-100 border-b border-slate-200 text-slate-700 font-bold z-10 shadow-xs">
            <tr>
              <th class="py-3 px-4">Centimeters</th>
              <th class="py-3 px-4">Meters</th>
              <th class="py-3 px-4">Feet &amp; Inches</th>
              <th class="py-3 px-4">Total Inches</th>
              <th class="py-3 px-4">Benchmark Note</th>
              <th class="py-3 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="chart-body" class="divide-y divide-slate-100 text-slate-600 bg-white">
            {chartRows.map((row) => (
              <tr class={`hover:bg-slate-50/80 transition-colors ${row.note ? 'bg-amber-50/30 font-medium' : ''}`}>
                <td class="py-2.5 px-4 font-bold text-slate-900">{row.cm} cm</td>
                <td class="py-2.5 px-4 text-slate-600">{row.meters} m</td>
                <td class="py-2.5 px-4 font-bold text-brand-700">{row.formatted}</td>
                <td class="py-2.5 px-4 text-slate-500">{(row.cm / 2.54).toFixed(1)}"</td>
                <td class="py-2.5 px-4">
                  {row.note ? (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-900">
                      ★ {row.note}
                    </span>
                  ) : (
                    <span class="text-slate-300">—</span>
                  )}
                </td>
                <td class="py-2.5 px-4 text-right">
                  <a
                    href={`/compare/?h1=${row.cm}`}
                    class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold text-brand-600 hover:text-white hover:bg-brand-600 border border-brand-200 hover:border-transparent transition-all"
                  >
                    Compare →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Height Reference Cards -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 mb-4">
        Global Population Stature Milestones
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center font-bold mb-3">
            ♀
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">Female Median (162 cm)</h3>
          <span class="text-xs font-bold text-pink-600 block mt-0.5">5 feet 4 inches</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Standard worldwide benchmark for adult women, commonly ranging between 158 cm and 168 cm across regions.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold mb-3">
            ♂
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">Male Median (175 cm)</h3>
          <span class="text-xs font-bold text-blue-600 block mt-0.5">5 feet 9 inches</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Worldwide adult male median stature, representing the global center of gravity for clothing and furniture standards.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center font-bold mb-3">
            🏆
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">6-Foot Threshold (183 cm)</h3>
          <span class="text-xs font-bold text-purple-600 block mt-0.5">6 feet 0 inches</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            The popular height milestone representing approximately the 85th percentile for adult men globally.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection faqs={faqs} />
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('chart-search') as HTMLInputElement;
  const tbody = document.getElementById('chart-body');

  if (searchInput && tbody) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      const rows = tbody.querySelectorAll('tr');

      rows.forEach((row) => {
        const text = row.textContent?.toLowerCase() || '';
        if (!q || text.includes(q)) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    });
  }
</script>
