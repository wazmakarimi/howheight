---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQSection from '../../components/seo/FAQSection.astro';
import CategoryIcon from '../../components/brand/CategoryIcon.astro';
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../data/categories';
import { getLocalizedCategory, getLocalizedPath, t } from '../../i18n';
import { getSafeInternalUrl } from '../../lib/internal-linking';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
// Page content is fully localized; locale copies still canonicalize to English (consolidation strategy).
const canonicalUrl =
  locale === 'en'
    ? `${SITE.siteUrl}${getLocalizedPath('/height-comparison-chart/', locale)}`
    : `${SITE.siteUrl}/height-comparison-chart/`;

// Conversion chart dataset from 140 cm (4'7") to 215 cm (7'0.7")
const chartRows = [];
for (let cm = 140; cm <= 215; cm += 2) {
  const totalInches = cm / 2.54;
  const feet = Math.floor(totalInches / 12);
  const inches = (totalInches % 12).toFixed(1);
  const formatted = `${feet}' ${inches}"`;
  const exactMeters = (cm / 100).toFixed(2);
  
  let note = '';
  if (cm === 140) note = t(locale, 'pg.chart.note.140');
  else if (cm === 150) note = t(locale, 'pg.chart.note.150');
  else if (cm === 160) note = t(locale, 'pg.chart.note.160');
  else if (cm === 162) note = t(locale, 'pg.chart.note.162');
  else if (cm === 166) note = t(locale, 'pg.chart.note.166');
  else if (cm === 170) note = t(locale, 'pg.chart.note.170');
  else if (cm === 174) note = t(locale, 'pg.chart.note.174');
  else if (cm === 176) note = t(locale, 'pg.chart.note.176');
  else if (cm === 178) note = t(locale, 'pg.chart.note.178');
  else if (cm === 180) note = t(locale, 'pg.chart.note.180');
  else if (cm === 182) note = t(locale, 'pg.chart.note.182');
  else if (cm === 188) note = t(locale, 'pg.chart.note.188');
  else if (cm === 196) note = t(locale, 'pg.chart.note.196');
  else if (cm === 198) note = t(locale, 'pg.chart.note.198');
  else if (cm === 210) note = t(locale, 'pg.chart.note.210');

  chartRows.push({ cm, meters: exactMeters, feet, inches, formatted, note });
}

const faqs = [1, 2, 3, 4].map((n) => ({
  question: t(locale, `pg.chart.faq${n}q`),
  answer: t(locale, `pg.chart.faq${n}a`),
}));
---

<Layout
  title={`${t(locale, 'pg.chart.title')} | ${SITE.name}`}
  description={t(locale, 'pg.chart.metaDesc')}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: t(locale, 'nav.home'), url: '/' },
        { name: t(locale, 'nav.compare'), url: '/height-comparison/' },
        { name: t(locale, 'pg.chart.title'), url: '/height-comparison-chart/' },
      ]}
    />

    <!-- Header -->
    <header class="text-center my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 mb-3 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span>{t(locale, 'pg.chart.badge')}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {t(locale, 'pg.chart.title')}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed max-w-3xl mx-auto">
        {t(locale, 'pg.chart.intro')}
      </p>
    </header>

    <!-- Category Shortcuts -->
    <div class="mb-10 p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-3">
        {t(locale, 'pg.chart.jump')}
      </span>
      <div class="flex flex-wrap gap-2">
        {CATEGORIES.map((c) => (
          <a
            href={c.route}
            class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-brand-50 hover:text-brand-600 text-xs font-semibold text-slate-700 transition-colors flex items-center gap-1.5 group"
          >
            <CategoryIcon categoryId={c.id} className="w-3.5 h-3.5 text-slate-500 group-hover:text-brand-600" />
            <span>{getLocalizedCategory(c, locale).name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Interactive Height Search / Filter -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-soft p-6 sm:p-8 mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            {t(locale, 'pg.chart.matrixTitle')}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            {t(locale, 'pg.chart.matrixSub')}
          </p>
        </div>
        <div class="w-full sm:w-64">
          <label for="chart-search" class="sr-only">{t(locale, 'pg.chart.searchLabel')}</label>
          <input
            type="text"
            id="chart-search"
            placeholder={t(locale, 'pg.chart.searchPh')}
            class="w-full px-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none"
          />
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto max-h-[650px] overflow-y-auto border border-slate-200 rounded-2xl">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead class="sticky top-0 bg-slate-100 border-b border-slate-200 text-slate-700 font-bold z-10 shadow-xs">
            <tr>
              <th class="py-3 px-4">{t(locale, 'pg.chart.thCm')}</th>
              <th class="py-3 px-4">{t(locale, 'pg.chart.thM')}</th>
              <th class="py-3 px-4">{t(locale, 'pg.chart.thFtIn')}</th>
              <th class="py-3 px-4">{t(locale, 'pg.chart.thTotalIn')}</th>
              <th class="py-3 px-4">{t(locale, 'pg.chart.thNote')}</th>
              <th class="py-3 px-4 text-right">{t(locale, 'pg.chart.thAction')}</th>
            </tr>
          </thead>
          <tbody id="chart-body" class="divide-y divide-slate-100 text-slate-600 bg-white">
            {chartRows.map((row) => (
              <tr class={`hover:bg-slate-50/80 transition-colors ${row.note ? 'bg-amber-50/30 font-medium' : ''}`}>
                <td class="py-2.5 px-4 font-bold text-slate-900">{row.cm} cm</td>
                <td class="py-2.5 px-4 text-slate-600">{row.meters} m</td>
                <td class="py-2.5 px-4 font-bold text-brand-700">{row.formatted}</td>
                <td class="py-2.5 px-4 text-slate-500">{(row.cm / 2.54).toFixed(1)}"</td>
                <td class="py-2.5 px-4">
                  {row.note ? (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-900">
                      ★ {row.note}
                    </span>
                  ) : (
                    <span class="text-slate-300">—</span>
                  )}
                </td>
                <td class="py-2.5 px-4 text-right">
                  <a
                    href={`/compare/?h1=${row.cm}`}
                    class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold text-brand-600 hover:text-white hover:bg-brand-600 border border-brand-200 hover:border-transparent transition-all"
                  >
                    {t(locale, 'pg.chart.compare')}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Height Reference Cards -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 mb-4">
        {t(locale, 'pg.chart.milesTitle')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center font-bold mb-3">
            ♀
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">{t(locale, 'pg.chart.mileF.t')}</h3>
          <span class="text-xs font-bold text-pink-600 block mt-0.5">{t(locale, 'pg.chart.mileF.sub')}</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            {t(locale, 'pg.chart.mileF.d')}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold mb-3">
            ♂
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">{t(locale, 'pg.chart.mileM.t')}</h3>
          <span class="text-xs font-bold text-blue-600 block mt-0.5">{t(locale, 'pg.chart.mileM.sub')}</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            {t(locale, 'pg.chart.mileM.d')}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-soft">
          <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center font-bold mb-3">
            🏆
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">{t(locale, 'pg.chart.mile6.t')}</h3>
          <span class="text-xs font-bold text-purple-600 block mt-0.5">{t(locale, 'pg.chart.mile6.sub')}</span>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            {t(locale, 'pg.chart.mile6.d')}
          </p>
        </div>
      </div>
    </section>

    <!-- Related Height Comparison Tools -->
    <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700 mb-8">
      <div class="mb-4">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          {t(locale, 'pg.shared.relTitle')}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          {t(locale, 'pg.shared.relSubChart')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <a
          href={getSafeInternalUrl('/height-comparison/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            {t(locale, 'pg.shared.hubT')}
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            {t(locale, 'pg.shared.hubD')}
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-calculator/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            {t(locale, 'pg.shared.calcT')}
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            {t(locale, 'pg.shared.calcD')}
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-visualizer/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            {t(locale, 'pg.shared.vizT')}
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            {t(locale, 'pg.shared.vizD')}
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-couple/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            {t(locale, 'pg.shared.coupleT')}
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            {t(locale, 'pg.shared.coupleD')}
          </span>
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection title={t(locale, 'pg.shared.faqTitle')} faqs={faqs} />
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('chart-search') as HTMLInputElement;
  const tbody = document.getElementById('chart-body');

  if (searchInput && tbody) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      const rows = tbody.querySelectorAll('tr');

      rows.forEach((row) => {
        const text = row.textContent?.toLowerCase() || '';
        if (!q || text.includes(q)) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    });
  }
</script>
