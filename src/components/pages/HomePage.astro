---
import Layout from '../../layouts/Layout.astro';
import ComparisonTool from '../ComparisonTool.astro';
import HeroSection from '../HeroSection.astro';
import CategoryIcon from '../brand/CategoryIcon.astro';
import FAQ from '../FAQ.astro';
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../data/categories';
import { CELEBRITIES } from '../../data/celebrities';
import { COMPARISONS } from '../../data/comparisons';
import { cmToFeetInches } from '../../lib/height';
import { getLocalizedPath, getLocalizedCategory, getLocalizedEntityName, t } from '../../i18n';
import { getSafeInternalUrl } from '../../lib/internal-linking';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Curated popular comparisons for homepage
const popularComparisons = COMPARISONS.slice(0, 6);

// Featured verified celebrities
const featuredCelebrities = CELEBRITIES.slice(0, 8);

// Popular canonical reference benchmarks
const popularCharts = [
  { label: '5 ft 4 in (162.6 cm)', category: 'Global Female Median', note: 'Standard worldwide baseline' },
  { label: '5 ft 9 in (175.3 cm)', category: 'Global Male Median', note: 'Worldwide adult male average' },
  { label: '5 ft 10 in (177.8 cm)', category: 'US/Europe Male Median', note: 'North American average stature' },
  { label: '6 ft 0 in (182.9 cm)', category: 'Tall Stature Benchmark', note: 'Top ~15th percentile globally' },
  { label: '6 ft 2 in (188.0 cm)', category: 'Athletic Benchmark', note: 'Top ~3rd percentile stature' },
  { label: '6 ft 6 in (198.1 cm)', category: 'Basketball / Pro Athlete', note: 'Elite athletic stature' },
];

const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath('/', locale)}`;
---

<Layout
  title={t(locale, 'meta.defaultTitle')}
  description={t(locale, 'meta.defaultDesc')}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-4">
    <!-- Hero Section -->
    <HeroSection locale={locale} />

    <!-- Interactive Comparison Tool Workspace -->
    <section id="comparison-tool" class="scroll-mt-20 my-8 sm:my-12">
      <div class="mb-4 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
          {t(locale, 'section.liveToolBadge')}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {t(locale, 'section.liveToolTitle')}
        </h2>
      </div>
      <ComparisonTool locale={locale} />
    </section>

    <!-- Category Navigation Hub -->
    <section id="categories" class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800 scroll-mt-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
            {t(locale, 'section.categoriesBadge')}
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-3">
            {t(locale, 'section.categoriesTitle')}
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 max-w-2xl mx-auto">
            {t(locale, 'section.categoriesDesc')}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {CATEGORIES.map((rawCat) => {
            const cat = getLocalizedCategory(rawCat, locale);
            return (
              <a
                href={getLocalizedPath(cat.route, locale)}
                class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all flex flex-col justify-between group"
              >
                <div>
                  <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 group-hover:bg-brand-50 dark:group-hover:bg-brand-950/60 group-hover:text-brand-600 dark:group-hover:text-blue-400 flex items-center justify-center mb-3 transition-colors">
                    <CategoryIcon categoryId={cat.id} className="w-5 h-5" />
                  </div>
                  <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors">
                    {cat.name}
                  </h3>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                    {cat.description}
                  </p>
                </div>
                <div class="flex items-center gap-1 text-xs font-bold text-brand-600 dark:text-blue-400 mt-3 pt-2 border-t border-slate-100 dark:border-slate-700">
                  <span>{t(locale, 'action.browse')} {cat.name}</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Popular Comparisons Section -->
    <section class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
              {t(locale, 'section.comparisonsBadge')}
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
              {t(locale, 'section.comparisonsTitle')}
            </h2>
          </div>
          <a href={getLocalizedPath('/compare/', locale)} class="text-xs font-bold text-brand-600 dark:text-blue-400 hover:underline flex items-center gap-1">
            {t(locale, 'section.createCustom')} →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {popularComparisons.map((comp) => (
            <a
              href={getLocalizedPath(`/compare/${comp.slug}/`, locale)}
              class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group flex flex-col justify-between"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-700 px-2 py-0.5 rounded">
                  {t(locale, 'section.curatedMatchup')}
                </span>
                <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors mt-2">
                  {comp.h1}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                  {comp.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs font-semibold text-slate-600 dark:text-slate-300">
                <span>{t(locale, 'section.viewComparison')}</span>
                <span class="text-brand-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Popular Celebrities Section -->
    <section class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-purple-700 dark:text-purple-400 bg-purple-50 dark:bg-slate-800 px-3 py-1 rounded-full">
              {t(locale, 'section.celebritiesBadge')}
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
              {t(locale, 'section.celebritiesTitle')}
            </h2>
          </div>
          <a href={getLocalizedPath('/celebrity-height-comparison/', locale)} class="text-xs font-bold text-brand-600 dark:text-blue-400 hover:underline flex items-center gap-1">
            {t(locale, 'action.viewAll')} →
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
          {featuredCelebrities.map((celeb) => {
            const ft = cmToFeetInches(celeb.heightCm);
            const localizedName = getLocalizedEntityName(celeb.slug, celeb.name, locale);
            return (
              <a
                href={getSafeInternalUrl(`/celebrity-height/${celeb.slug}/`, locale)}
                class="p-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                    <span class="font-bold text-brand-600 dark:text-blue-400 uppercase truncate">{celeb.profession}</span>
                    <span>{celeb.country}</span>
                  </div>
                  <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors truncate">
                    {localizedName}
                  </h3>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs">
                  <span class="font-bold text-slate-800 dark:text-slate-100">{ft.formatted}</span>
                  <span class="text-slate-400 font-medium">{celeb.heightCm} {t(locale, 'unit.cm')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Popular Reference Heights & Charts Section -->
    <section class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-slate-800 px-3 py-1 rounded-full">
              {t(locale, 'section.benchmarksBadge')}
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
              {t(locale, 'section.benchmarksTitle')}
            </h2>
          </div>
          <div class="flex items-center gap-3">
            <a href={getLocalizedPath('/how-to-use/', locale)} class="text-xs font-bold text-brand-600 dark:text-blue-400 hover:underline">
              {t(locale, 'nav.howToUse') || 'How to Use'} →
            </a>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <a href={getLocalizedPath('/height-comparison-chart/', locale)} class="text-xs font-bold text-brand-600 dark:text-blue-400 hover:underline">
              {t(locale, 'nav.chart')} →
            </a>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <a href={getLocalizedPath('/height-comparison-calculator/', locale)} class="text-xs font-bold text-brand-600 dark:text-blue-400 hover:underline">
              {t(locale, 'nav.calculator')} →
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {popularCharts.map((chart) => (
            <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft text-center">
              <span class="text-xs font-extrabold text-slate-900 dark:text-white block">{chart.label}</span>
              <span class="text-[11px] font-bold text-brand-600 dark:text-blue-400 block mt-0.5">{chart.category}</span>
              <span class="text-[10px] text-slate-400 block mt-1 leading-tight">{chart.note}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQ locale={locale} />
  </div>
</Layout>
