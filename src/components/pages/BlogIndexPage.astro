---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { getAllArticles, BLOG_CATEGORIES } from '../../data/blog';
import { getLocalizedPath, t } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { getSafeInternalUrl } from '../../lib/internal-linking';

interface Props {
  locale?: Locale;
  categoryFilter?: string;
}

const { locale = 'en', categoryFilter } = Astro.props;
const allArticles = getAllArticles();
const filteredArticles = categoryFilter
  ? allArticles.filter((art) => art.category === categoryFilter)
  : allArticles;

const featuredArticle = filteredArticles[0] || allArticles[0];
const gridArticles = filteredArticles.filter((art) => art.slug !== featuredArticle.slug);

const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath('/blog/', locale)}`;

const pageTitle = categoryFilter && BLOG_CATEGORIES[categoryFilter]
  ? `${BLOG_CATEGORIES[categoryFilter].name} – Height Analysis Blog | ${SITE.name}`
  : `Height Comparison & Scale Blog – Visual Analysis & Real-World Guides | ${SITE.name}`;

const pageDescription = 'Explore research-backed height comparisons, celebrity stature breakdowns, sports biomechanics, animal scales, and architectural clearances on HowHeight.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: 'Blog', url: '/blog/' },
      ]}
    />

    <!-- Hero Header -->
    <header class="text-center my-6 sm:my-10 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 dark:bg-slate-800 text-brand-700 dark:text-blue-400 border border-brand-200/80 dark:border-slate-700 mb-4 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>Research &amp; Visual Comparisons</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Height &amp; Scale Analysis Blog
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">
        Accurate, factual deep dives into human stature, athletic physics, celebrity frames, animal dimensions, and real-world spatial scale.
      </p>
    </header>

    <!-- Category Filter Pills -->
    <div class="flex items-center justify-center gap-2 flex-wrap mb-10">
      <a
        href={getSafeInternalUrl('/blog/', locale)}
        class={`px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all ${
          !categoryFilter
            ? 'bg-brand-600 text-white shadow-soft'
            : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-brand-300'
        }`}
      >
        All Articles ({allArticles.length})
      </a>
      {Object.values(BLOG_CATEGORIES).map((cat) => {
        const count = allArticles.filter((a) => a.category === cat.id).length;
        if (count === 0) return null;
        const isActive = categoryFilter === cat.id;
        return (
          <a
            href={getSafeInternalUrl(`/blog/?category=${cat.id}`, locale)}
            class={`px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all ${
              isActive
                ? 'bg-brand-600 text-white shadow-soft'
                : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-brand-300'
            }`}
          >
            {cat.name} ({count})
          </a>
        );
      })}
    </div>

    <!-- Featured Lead Article (Hero Card) -->
    {featuredArticle && (
      <section class="mb-12">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 via-slate-900 to-slate-950 text-white p-6 sm:p-10 lg:p-12 shadow-xl border border-slate-800">
          <div class="relative z-10 max-w-3xl">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wide bg-brand-500/20 text-brand-300 border border-brand-500/30">
                Featured Analysis
              </span>
              <span class="text-xs text-slate-400 font-medium">
                {new Date(featuredArticle.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
              <span class="text-xs text-slate-400 font-medium">
                • {featuredArticle.readingTimeMinutes} min read
              </span>
            </div>

            <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-4 leading-snug">
              <a
                href={getSafeInternalUrl(`/blog/${featuredArticle.slug}/`, locale)}
                class="hover:text-brand-300 transition-colors"
              >
                {featuredArticle.title}
              </a>
            </h2>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
              {featuredArticle.quickAnswer.summary}
            </p>

            <div class="flex items-center justify-between gap-4 flex-wrap pt-4 border-t border-slate-800/80">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-brand-500/30 border border-brand-400/40 flex items-center justify-center font-bold text-sm text-brand-300">
                  {featuredArticle.author.name.charAt(0)}
                </div>
                <div>
                  <div class="text-sm font-bold text-white">{featuredArticle.author.name}</div>
                  <div class="text-xs text-slate-400">{featuredArticle.author.role}</div>
                </div>
              </div>

              <a
                href={getSafeInternalUrl(`/blog/${featuredArticle.slug}/`, locale)}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-bold text-sm transition-all shadow-md shadow-brand-500/20"
              >
                <span>Read Analysis &amp; Visual Tool</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Articles Grid -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          {categoryFilter ? `${BLOG_CATEGORIES[categoryFilter]?.name || 'Articles'}` : 'Latest Research & Comparisons'}
        </h2>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          Showing {filteredArticles.length} {filteredArticles.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredArticles.map((article) => {
          const catMeta = BLOG_CATEGORIES[article.category];
          return (
            <article class="flex flex-col justify-between p-6 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft hover:shadow-hover hover:border-brand-300 dark:hover:border-blue-600 transition-all group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`px-2.5 py-1 rounded-full text-xs font-bold ${catMeta?.badgeColor || 'bg-slate-100 text-slate-700'}`}>
                    {catMeta?.name || article.category}
                  </span>
                  <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                    {article.readingTimeMinutes} min read
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors leading-snug mb-3">
                  <a href={getSafeInternalUrl(`/blog/${article.slug}/`, locale)}>
                    {article.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed mb-4">
                  {article.description}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  <span class="font-medium text-slate-700 dark:text-slate-300 block">{article.author.name}</span>
                  <span class="text-[11px] text-slate-400">{new Date(article.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>

                <a
                  href={getSafeInternalUrl(`/blog/${article.slug}/`, locale)}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Explore</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Comparison Hub Tools Promo -->
    <section class="rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 p-6 sm:p-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          Explore HowHeight Interactive Comparison Tools
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
          Put numbers into perspective. Use our full suite of visual calculators, conversion charts, and side-by-side scale simulators.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href={getSafeInternalUrl('/height-comparison/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block">
            Height Comparison Hub
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">
            Multi-figure side-by-side scale engine with verified silhouettes.
          </span>
        </a>

        <a
          href={getSafeInternalUrl('/height-comparison-calculator/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block">
            Height Calculator
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">
            Metric to imperial differences, exact gaps, and ratio calculations.
          </span>
        </a>

        <a
          href={getSafeInternalUrl('/height-comparison-visualizer/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block">
            Visualizer Tool
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">
            Compare humans, animals, anime, and vehicles on a 2D scale plane.
          </span>
        </a>

        <a
          href={getSafeInternalUrl('/height-comparison-chart/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block">
            Height Chart Tables
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">
            Complete centimeter-to-inches conversion matrix and percentiles.
          </span>
        </a>
      </div>
    </section>
  </div>
</Layout>
