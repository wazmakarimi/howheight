---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { getLocalizedPath, t } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const canonicalUrl = `${SITE.siteUrl}/privacy/`;
const lastUpdated = 'September 24, 2026';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Privacy Policy',
  'url': canonicalUrl,
  'description': 'HowHeight privacy policy explaining data collection, analytics usage, cookie handling, and user privacy rights.',
};
---

<Layout
  title={`Privacy Policy | ${SITE.name}`}
  description="HowHeight privacy policy explaining data collection, analytics usage, cookie handling, and user privacy rights."
  canonicalUrl={canonicalUrl}
  locale={locale}
  suppressDefaultSchema={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} slot="head" />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: t(locale, 'footer.privacy'), url: '/privacy/' },
      ]}
    />

    <!-- Header -->
    <header class="text-center my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-blue-300 border border-brand-200/80 dark:border-brand-800/60 mb-3 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Privacy &amp; Data Transparency</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Privacy Policy
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
        Last updated: <time datetime="2026-09-24">{lastUpdated}</time>
      </p>
    </header>

    <!-- Main Content Articles -->
    <article class="prose prose-slate max-w-none space-y-8 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
      <!-- 1. Introduction -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          1. About HowHeight &amp; This Policy
        </h2>
        <p>
          <strong>HowHeight.org</strong> is a free, interactive height comparison web tool engineered and maintained by <strong>Firoz Khan</strong> (FK Digital Media). The platform enables users to visually compare physical heights and proportions across people, celebrities, anime figures, cinema characters, animals, plants, objects, and sports equipment on a calibrated digital canvas.
        </p>
        <p class="mt-3">
          This Privacy Policy explains what information may be collected when you access HowHeight, how that data is used, and the privacy controls available to you. We believe in minimal data footprint and straightforward, honest practices.
        </p>
      </section>

      <!-- 2. Personal Information -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          2. Information We Do Not Collect
        </h2>
        <p>
          HowHeight is an open educational utility. To use our comparison tool, browse categories, or calculate height differences:
        </p>
        <ul class="mt-3 space-y-2 list-disc pl-5">
          <li><strong>No Account Required:</strong> You do not need to register, log in, or create a user profile.</li>
          <li><strong>No Personal Details:</strong> We do not collect names, home addresses, phone numbers, or passwords.</li>
          <li><strong>No Financial Data:</strong> HowHeight is 100% free to access; we never collect credit card or payment information.</li>
        </ul>
      </section>

      <!-- 3. Web Analytics (Google Analytics) -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          3. Analytics &amp; Website Usage Telemetry
        </h2>
        <p>
          To understand how visitors use our platform, diagnose technical errors, and optimize site performance, we utilize <strong>Google Analytics 4 (GA4)</strong> (Measurement ID: <code>G-BNEEVVXP3R</code>), provided by Google LLC.
        </p>
        <p class="mt-3">
          Google Analytics collects aggregated, non-personally identifiable telemetry such as:
        </p>
        <ul class="mt-3 space-y-2 list-disc pl-5">
          <li>Pages visited, referring URLs, and time spent on pages.</li>
          <li>Device type, browser family, operating system, and approximate screen resolution.</li>
          <li>General geographical region (country and city level; IP addresses are masked and anonymized by default in GA4).</li>
        </ul>
        <p class="mt-3">
          This data is processed strictly in aggregate to evaluate site performance and ensure reliable server response times.
        </p>
      </section>

      <!-- 4. Cookies & Local Storage -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          4. Cookies &amp; Browser Storage
        </h2>
        <p>
          HowHeight minimizes the use of browser storage mechanisms:
        </p>
        <ul class="mt-3 space-y-3 list-disc pl-5">
          <li>
            <strong>Analytics Cookies:</strong> Google Analytics sets first-party analytical cookies (such as <code>_ga</code> and <code>_ga_*</code>) to distinguish unique visitor sessions across page requests. These cookies do not contain personally identifying information.
          </li>
          <li>
            <strong>Theme Preferences (Local Storage):</strong> We use client-side <code>localStorage</code> (key: <code>theme</code>) exclusively to store your preferred viewing mode (Light Mode or Dark Mode). This preference stays on your local browser and is never transmitted to our servers.
          </li>
          <li>
            <strong>No Advertising Cookies:</strong> We do not set third-party cross-site tracking cookies, behavioral profile cookies, or ad retargeting beacons.
          </li>
        </ul>
      </section>

      <!-- 5. Advertising Disclosures -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          5. Advertising Disclosures
        </h2>
        <p>
          HowHeight does <strong>not</strong> display third-party banner advertising, programmatic video ads, or sponsored promotional popups. We do not integrate Google AdSense or any third-party programmatic ad-exchange scripts.
        </p>
      </section>

      <!-- 6. Third-Party Services -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          6. Third-Party Services in Use
        </h2>
        <p>
          The only third-party services actively loaded by HowHeight are:
        </p>
        <ul class="mt-3 space-y-2 list-disc pl-5">
          <li><strong>Google Tag Manager / Google Analytics 4:</strong> For anonymous usage statistics as described above.</li>
          <li><strong>Google Fonts:</strong> Web typography (Inter and Plus Jakarta Sans) loaded from Google's content delivery servers (<code>fonts.googleapis.com</code> and <code>fonts.gstatic.com</code>). When your browser requests these font files, standard network metadata (such as your IP address) is received by Google servers in accordance with Google's public font privacy guidelines.</li>
          <li><strong>Hosting &amp; Content Delivery:</strong> Static assets are hosted and served via cloud content delivery network infrastructure, which processes standard HTTP request headers to deliver web pages securely.</li>
        </ul>
      </section>

      <!-- 7. Data Retention & Security -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          7. Data Retention &amp; Security
        </h2>
        <p>
          Because HowHeight does not operate a database of registered users or personal profiles, we do not store or retain personal data. Analytical telemetry stored in Google Analytics is retained according to Google's standard retention cycles (ranging from 2 to 14 months) before automatic deletion.
        </p>
        <p class="mt-3">
          All site traffic is transmitted over encrypted HTTPS (TLS) connections to protect network integrity.
        </p>
      </section>

      <!-- 8. User Rights & Privacy Controls -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          8. Your Rights &amp; Privacy Controls
        </h2>
        <p>
          You have full control over your browsing data:
        </p>
        <ul class="mt-3 space-y-2 list-disc pl-5">
          <li><strong>Disabling Cookies:</strong> You can configure your browser to block or delete cookies at any time. HowHeight's comparison tool functions normally even if cookies are disabled.</li>
          <li><strong>Opting Out of Google Analytics:</strong> You may prevent Google Analytics from collecting usage telemetry by installing the official <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-brand-600 dark:text-blue-400 underline hover:no-underline">Google Analytics Opt-out Browser Add-on</a>.</li>
          <li><strong>Clearing Local Preferences:</strong> You can clear your theme preference anytime by resetting your browser's site data.</li>
        </ul>
      </section>

      <!-- 9. Contact for Privacy Inquiries -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          9. Privacy Inquiries &amp; Contact
        </h2>
        <p>
          If you have questions regarding this Privacy Policy or our data handling practices, please visit our dedicated <a href={getLocalizedPath('/contact/', locale)} class="text-brand-600 dark:text-blue-400 font-semibold underline hover:no-underline">Contact Page</a> to reach the site maintainer.
        </p>
      </section>

      <!-- 10. Updates to This Policy -->
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
          10. Changes to This Policy
        </h2>
        <p>
          We may update this Privacy Policy from time to time to reflect modifications in site functionality or legal requirements. Any revisions will be published directly on this page with an updated revision date.
        </p>
      </section>
    </article>
  </div>
</Layout>
