---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import CategoryIcon from '../brand/CategoryIcon.astro';
import { SITE } from '../../config/site';
import { CATEGORIES } from '../../data/categories';
import { getLocalizedCategory, getLocalizedPath, t } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath('/about/', locale)}`;
---

<Layout
  title={`${t(locale, 'footer.about')} HowHeight – ${t(locale, 'brand.tagline')} | ${SITE.name}`}
  description={t(locale, 'about.desc')}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: t(locale, 'footer.about'), url: '/about/' },
      ]}
    />

    <!-- Header -->
    <header class="text-center my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200/80 mb-3 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>{t(locale, 'footer.platformStatement')}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {t(locale, 'about.title')}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed max-w-2xl mx-auto">
        {t(locale, 'brand.tagline')}. {t(locale, 'brand.description')}
      </p>
    </header>

    <!-- Main Content Articles -->
    <article class="prose prose-slate max-w-none space-y-10 text-sm sm:text-base leading-relaxed text-slate-700">
      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-4">
          Our Core Mission
        </h2>
        <p>
          Human beings are inherently visual creatures, yet traditional numbers and measurement charts struggle to convey what physical heights truly look and feel like in real space. Comparing an actor listed at 170 cm with a doorway listed at 210 cm or an African Elephant listed at 320 cm shoulder height requires intuitive geometric perspective.
        </p>
        <p class="mt-3">
          <strong>HowHeight</strong> was built to solve this problem across ten diverse categories—spanning humans, verified celebrities, anime heroes, cinema figures, zoological species, architectural elements, plants, sports equipment, and footwear—on a unified, mathematically rigorous digital canvas.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-4">
          Scientific Measurement Methodology
        </h2>
        <ul class="space-y-3 list-disc pl-5">
          <li><strong>Universal Mathematical Scale:</strong> Every silhouette and photo is projected using strict pixel-to-centimeter ratios.</li>
          <li><strong>Strict Baseline Anchoring:</strong> Every entity stands anchored to the exact same 0 cm baseline floor plane.</li>
          <li><strong>Dual Vector &amp; Raster Projection:</strong> Supports both precision vector SVGs and transparent cutout PNGs with preserved aspect ratio.</li>
        </ul>
      </div>

      <!-- Categories Supported -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-4">
          Supported Categories
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {CATEGORIES.map((rawCat) => {
            const cat = getLocalizedCategory(rawCat, locale);
            return (
              <a
                href={getLocalizedPath(cat.route, locale)}
                class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-all text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-brand-600 dark:hover:text-blue-400 flex items-center gap-2"
              >
                <CategoryIcon categoryId={cat.id} className="w-4 h-4 text-brand-600 dark:text-blue-400" />
                <span>{cat.name}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Developer & Creator: FK Digital Media / Firoz Khan -->
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-white via-slate-50 to-blue-50/30 dark:from-slate-800 dark:via-slate-800/90 dark:to-brand-950/40 border border-slate-200/90 dark:border-slate-700 shadow-soft">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-blue-300 border border-brand-200/80 dark:border-brand-800/60 shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span>Developer &amp; Engineering</span>
            </div>

            <div>
              <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
                FK Digital Media
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-brand-600 dark:text-blue-400 mt-0.5">
                Created &amp; Maintained by Firoz Khan
              </p>
            </div>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              HowHeight is engineered and actively developed by <strong>Firoz Khan</strong> (FK Digital Media), focusing on delivering mathematically precise visual comparison tools, responsive web architecture, and global SEO-optimized platforms.
            </p>
          </div>

          <!-- Social / Portfolio Action Buttons -->
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full md:w-auto shrink-0">
            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/firoz-khan-1153358a/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#0A66C2] hover:bg-[#084e96] text-white text-xs sm:text-sm font-bold shadow-soft-sm hover:shadow-soft transition-all active:scale-[0.98] w-full sm:w-auto"
              aria-label="Firoz Khan on LinkedIn"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
              </svg>
              <span>LinkedIn</span>
              <svg class="w-3.5 h-3.5 text-blue-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>

            <!-- GitHub -->
            <a
              href="https://github.com/fkdigitalmedia"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white text-xs sm:text-sm font-bold shadow-soft-sm hover:shadow-soft transition-all active:scale-[0.98] w-full sm:w-auto"
              aria-label="FK Digital Media on GitHub"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub</span>
              <svg class="w-3.5 h-3.5 text-slate-300 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </article>
  </div>
</Layout>
