---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQSection from '../../components/seo/FAQSection.astro';
import { SITE } from '../../config/site';
import { getLocalizedPath, t } from '../../i18n';
import { getSafeInternalUrl } from '../../lib/internal-linking';
import { getCalculatorData } from '../../data/calculator';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
  canonicalPath?: string;
}

const { locale = 'en', canonicalPath = '/height-comparison-calculator/' } = Astro.props;
const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath(canonicalPath, locale)}`;
const calc = getCalculatorData(locale);
const unitCm = t(locale, 'unit.cm');
const unitIn = t(locale, 'unit.in');
const unitFt = t(locale, 'unit.ft');

// Pre-computed initial values for SSR
const initialCmA = 175;
const initialCmB = 163;
const initialDiffCm = 12;
const initialDiffIn = '4.7';
const initialPct = '7.4';

const initialHeadline = calc.diffHeadline
  .replace('{diffCm}', String(initialDiffCm))
  .replace('{diffIn}', initialDiffIn);

const initialStatement = calc.tallerStatement
  .replace('{nameA}', calc.defaultNameA)
  .replace('{nameB}', calc.defaultNameB)
  .replace('{diffCm}', String(initialDiffCm))
  .replace('{diffIn}', initialDiffIn)
  .replace('{pctDiff}', initialPct);

const compareBaseUrl = getLocalizedPath('/compare/', locale);
const initialCompareHref = `${compareBaseUrl.endsWith('/') ? compareBaseUrl : compareBaseUrl + '/'}?h1=${initialCmA}&h2=${initialCmB}`;

const quickMatchups = [
  { nameA: 'Dwayne Johnson', cmA: 196, nameB: 'Tom Cruise', cmB: 170, label: 'Dwayne Johnson vs Tom Cruise' },
  { nameA: 'Virat Kohli', cmA: 175, nameB: 'MS Dhoni', cmB: 178, label: 'Virat Kohli vs MS Dhoni' },
  { nameA: 'Average Male', cmA: 176, nameB: 'Average Female', cmB: 162, label: 'Average Male vs Female' },
  { nameA: 'Dwayne Johnson', cmA: 196, nameB: 'Riding Horse (withers)', cmB: 160, label: 'Dwayne Johnson vs Horse' },
  { nameA: 'Average Male', cmA: 176, nameB: 'Standard Door', cmB: 210, label: 'Human vs Door' },
];
const isComparisonCalculator = canonicalPath.includes('height-comparison-calculator');
const pageTitle = isComparisonCalculator && locale === 'en' ? `Height Comparison Calculator | ${SITE.name}` : calc.seo.title;
const pageH1 = isComparisonCalculator && locale === 'en' ? 'Height Comparison Calculator' : calc.h1;
const pageDesc = isComparisonCalculator && locale === 'en' ? 'Interactive height comparison calculator. Calculate exact height differences, percentage ratios, and comparative statements in cm, meters, and feet/inches on HowHeight.' : calc.seo.description;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div
    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12"
    id="calculator-app"
    data-default-name-a={calc.defaultNameA}
    data-default-name-b={calc.defaultNameB}
    data-same-headline={calc.sameHeightHeadline}
    data-same-statement={calc.sameHeightStatement}
    data-taller-statement={calc.tallerStatement}
    data-diff-headline={calc.diffHeadline}
    data-compare-base={compareBaseUrl}
    data-unit-cm={unitCm}
    data-unit-in={unitIn}
    data-unit-ft={unitFt}
  >
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: 'Height Comparison', url: '/height-comparison/' },
        { name: pageH1, url: canonicalPath },
      ]}
    />

    <!-- Header -->
    <header class="text-center my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-blue-300 border border-brand-200/80 dark:border-brand-800 mb-3 shadow-soft-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/>
          <path d="m14.5 12.5 2-2"/>
          <path d="m11.5 9.5 2-2"/>
          <path d="m8.5 6.5 2-2"/>
          <path d="m17.5 15.5 2-2"/>
        </svg>
        <span>{calc.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {pageH1}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-3 leading-relaxed max-w-2xl mx-auto">
        {calc.subtitle}
      </p>
    </header>

    <!-- Interactive Calculator Card -->
    <div class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-200/80 dark:border-slate-700 shadow-soft-lg p-6 sm:p-10 mb-12">
      <!-- Quick Comparison Matchups from Database -->
      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2.5">
          Quick Preset Comparisons (From Verified Database)
        </span>
        <div class="flex flex-wrap gap-2">
          {quickMatchups.map((m) => (
            <button
              type="button"
              class="quick-matchup-btn px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:border-brand-500 hover:text-brand-600 dark:hover:text-blue-400 transition-all shadow-soft-sm active:scale-95"
              data-name-a={m.nameA}
              data-cm-a={m.cmA}
              data-name-b={m.nameB}
              data-cm-b={m.cmB}
            >
              {m.label}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Person / Entity A -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700">
          <div class="flex items-center justify-between mb-4">
            <span class="font-extrabold text-sm uppercase tracking-wider text-brand-600 dark:text-blue-400">{calc.personA}</span>
            <div class="inline-flex rounded-lg bg-slate-200 dark:bg-slate-700 p-0.5 text-xs font-semibold">
              <button type="button" class="unit-toggle-a px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm" data-unit="cm">cm</button>
              <button type="button" class="unit-toggle-a px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white" data-unit="ft">ft / in</button>
            </div>
          </div>

          <label for="name-a" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.nameLabel}</label>
          <input
            type="text"
            id="name-a"
            value={calc.defaultNameA}
            class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none mb-4"
          />

          <!-- CM Input Mode -->
          <div id="input-a-cm-container">
            <label for="height-a-cm" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.heightCmLabel}</label>
            <div class="relative">
              <input
                type="number"
                id="height-a-cm"
                value="175"
                min="20"
                max="350"
                class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none pr-10"
              />
              <span class="absolute right-3 top-2.5 text-sm font-semibold text-slate-400">cm</span>
            </div>
          </div>

          <!-- FT/IN Input Mode -->
          <div id="input-a-ft-container" class="hidden">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="height-a-ft" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.feetLabel}</label>
                <input
                  type="number"
                  id="height-a-ft"
                  value="5"
                  min="1"
                  max="11"
                  class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none"
                />
              </div>
              <div>
                <label for="height-a-in" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.inchesLabel}</label>
                <input
                  type="number"
                  id="height-a-in"
                  value="9"
                  min="0"
                  max="11.9"
                  step="0.1"
                  class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Person / Entity B -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700">
          <div class="flex items-center justify-between mb-4">
            <span class="font-extrabold text-sm uppercase tracking-wider text-purple-700 dark:text-purple-400">{calc.personB}</span>
            <div class="inline-flex rounded-lg bg-slate-200 dark:bg-slate-700 p-0.5 text-xs font-semibold">
              <button type="button" class="unit-toggle-b px-2.5 py-1 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm" data-unit="cm">cm</button>
              <button type="button" class="unit-toggle-b px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white" data-unit="ft">ft / in</button>
            </div>
          </div>

          <label for="name-b" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.nameLabel}</label>
          <input
            type="text"
            id="name-b"
            value={calc.defaultNameB}
            class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500 focus:outline-none mb-4"
          />

          <!-- CM Input Mode -->
          <div id="input-b-cm-container">
            <label for="height-b-cm" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.heightCmLabel}</label>
            <div class="relative">
              <input
                type="number"
                id="height-b-cm"
                value="163"
                min="20"
                max="350"
                class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none pr-10"
              />
              <span class="absolute right-3 top-2.5 text-sm font-semibold text-slate-400">cm</span>
            </div>
          </div>

          <!-- FT/IN Input Mode -->
          <div id="input-b-ft-container" class="hidden">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="height-b-ft" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.feetLabel}</label>
                <input
                  type="number"
                  id="height-b-ft"
                  value="5"
                  min="1"
                  max="11"
                  class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none"
                />
              </div>
              <div>
                <label for="height-b-in" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">{calc.inchesLabel}</label>
                <input
                  type="number"
                  id="height-b-in"
                  value="4.2"
                  min="0"
                  max="11.9"
                  step="0.1"
                  class="w-full px-3 py-2.5 text-base font-bold text-slate-900 dark:text-white rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-brand-500 focus:outline-none"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Display Box -->
      <div class="mt-8 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white shadow-soft">
        <div class="text-center mb-6">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-300">
            {calc.resultTitle}
          </span>
          <div id="diff-headline" class="text-2xl sm:text-4xl font-black tracking-tight mt-1 text-white">
            {initialHeadline}
          </div>
          <p id="diff-statement" class="text-sm text-slate-300 mt-2 max-w-lg mx-auto leading-relaxed">
            {initialStatement}
          </p>
        </div>

        <!-- Metric Details Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center mb-6">
          <div class="p-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10">
            <span class="text-[11px] uppercase font-bold text-slate-300 block">{calc.statCm}</span>
            <span id="stat-cm" class="text-lg sm:text-xl font-black text-white block mt-0.5">12 {unitCm}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10">
            <span class="text-[11px] uppercase font-bold text-slate-300 block">{calc.statIn}</span>
            <span id="stat-in" class="text-lg sm:text-xl font-black text-white block mt-0.5">4.7 {unitIn}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10">
            <span class="text-[11px] uppercase font-bold text-slate-300 block">{calc.statFt}</span>
            <span id="stat-ft" class="text-lg sm:text-xl font-black text-white block mt-0.5">0' 4.7"</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10">
            <span class="text-[11px] uppercase font-bold text-slate-300 block">{calc.statPct}</span>
            <span id="stat-pct" class="text-lg sm:text-xl font-black text-emerald-400 block mt-0.5">{initialPct}%</span>
          </div>
        </div>

        <!-- Visual Bar Scale Indicator -->
        <div class="space-y-3 max-w-md mx-auto mb-8">
          <div>
            <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
              <span id="bar-label-a">{calc.defaultNameA}: 175 {unitCm} (5' 9")</span>
              <span id="bar-val-a" class="text-white font-bold">100%</span>
            </div>
            <div class="w-full bg-white/10 h-3 rounded-full overflow-hidden">
              <div id="bar-a" class="bg-brand-500 h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
              <span id="bar-label-b">{calc.defaultNameB}: 163 {unitCm} (5' 4.2")</span>
              <span id="bar-val-b" class="text-white font-bold">93.1%</span>
            </div>
            <div class="w-full bg-white/10 h-3 rounded-full overflow-hidden">
              <div id="bar-b" class="bg-purple-500 h-full rounded-full transition-all duration-300" style="width: 93.1%;"></div>
            </div>
          </div>
        </div>

        <!-- Visual Compare Action CTA -->
        <div class="text-center">
          <a
            id="compare-link"
            href={initialCompareHref}
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-bold text-sm sm:text-base text-slate-900 bg-white hover:bg-slate-100 shadow-soft active:scale-[0.98] transition-all"
          >
            <span>{calc.ctaButton}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Reference Height Difference Table -->
    <section class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 mb-12 shadow-soft">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-3">
        {calc.tableTitle}
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6">
        {calc.tableSubtitle}
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left rtl:text-right border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-bold">
              <th class="py-2.5 px-3">{calc.thGap}</th>
              <th class="py-2.5 px-3">{calc.thAppearance}</th>
              <th class="py-2.5 px-3">{calc.thEffect}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 text-slate-600 dark:text-slate-300">
            {calc.tableRows.map((row) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-700/60">
                <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">{row.gap}</td>
                <td class="py-2.5 px-3">{row.appearance}</td>
                <td class="py-2.5 px-3">{row.effect}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Related Height Comparison Tools -->
    <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700 mb-8">
      <div class="mb-4">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Related Height Comparison Tools
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Explore additional visualizers, charts, and specialized comparison tools.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <a
          href={getSafeInternalUrl('/height-comparison/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            Height Comparison Hub
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            Complete guide &amp; multi-category visual comparison workspace.
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-visualizer/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            Height Comparison Visualizer
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            2D scale canvas for side-by-side human, celebrity &amp; animal figures.
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-chart/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            Height Comparison Chart
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            Authoritative conversion table in centimeters, meters &amp; feet/inches.
          </span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-couple/', locale)}
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group"
        >
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 block mb-1">
            Couple Height Comparison
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 block">
            Partner comparison with eye-level alignment &amp; difference metrics.
          </span>
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection faqs={calc.faqs} />
  </div>
</Layout>

<script>
  let unitModeA = 'cm';
  let unitModeB = 'cm';

  const app = document.getElementById('calculator-app');
  const defaultNameA = app?.dataset.defaultNameA || 'Person 1';
  const defaultNameB = app?.dataset.defaultNameB || 'Person 2';
  const sameHeadlineTpl = app?.dataset.sameHeadline || 'Exact Same Height (0 cm)';
  const sameStmtTpl = app?.dataset.sameStatement || '{nameA} and {nameB} stand at the exact same stature of {cm} cm ({ftIn}).';
  const tallerStmtTpl = app?.dataset.tallerStatement || '{nameA} is {diffCm} cm ({diffIn} in) taller than {nameB} ({pctDiff}% height difference).';
  const diffHeadlineTpl = app?.dataset.diffHeadline || '{diffCm} cm Difference ({diffIn} inches)';
  const compareBase = app?.dataset.compareBase || '/compare/';
  const unitCm = app?.dataset.unitCm || 'cm';
  const unitIn = app?.dataset.unitIn || 'in';

  const nameAInput = document.getElementById('name-a') as HTMLInputElement;
  const nameBInput = document.getElementById('name-b') as HTMLInputElement;

  const heightACmInput = document.getElementById('height-a-cm') as HTMLInputElement;
  const heightAFtInput = document.getElementById('height-a-ft') as HTMLInputElement;
  const heightAInInput = document.getElementById('height-a-in') as HTMLInputElement;

  const heightBCmInput = document.getElementById('height-b-cm') as HTMLInputElement;
  const heightBFtInput = document.getElementById('height-b-ft') as HTMLInputElement;
  const heightBInInput = document.getElementById('height-b-in') as HTMLInputElement;

  const diffHeadline = document.getElementById('diff-headline');
  const diffStatement = document.getElementById('diff-statement');
  const statCm = document.getElementById('stat-cm');
  const statIn = document.getElementById('stat-in');
  const statFt = document.getElementById('stat-ft');
  const statPct = document.getElementById('stat-pct');

  const barLabelA = document.getElementById('bar-label-a');
  const barLabelB = document.getElementById('bar-label-b');
  const barValA = document.getElementById('bar-val-a');
  const barValB = document.getElementById('bar-val-b');
  const barA = document.getElementById('bar-a');
  const barB = document.getElementById('bar-b');
  const compareLink = document.getElementById('compare-link') as HTMLAnchorElement;

  function cmToFtIn(cm: number) {
    const totalInches = cm / 2.54;
    const feet = Math.floor(totalInches / 12);
    const inches = (totalInches % 12).toFixed(1);
    return { feet, inches, formatted: `${feet}' ${inches}"` };
  }

  function getCmA(): number {
    if (unitModeA === 'cm') {
      return parseFloat(heightACmInput.value) || 0;
    } else {
      const ft = parseFloat(heightAFtInput.value) || 0;
      const inc = parseFloat(heightAInInput.value) || 0;
      return Math.round((ft * 12 + inc) * 2.54 * 10) / 10;
    }
  }

  function getCmB(): number {
    if (unitModeB === 'cm') {
      return parseFloat(heightBCmInput.value) || 0;
    } else {
      const ft = parseFloat(heightBFtInput.value) || 0;
      const inc = parseFloat(heightBInInput.value) || 0;
      return Math.round((ft * 12 + inc) * 2.54 * 10) / 10;
    }
  }

  function recalculate() {
    const cmA = getCmA();
    const cmB = getCmB();
    const nameA = nameAInput.value.trim() || defaultNameA;
    const nameB = nameBInput.value.trim() || defaultNameB;

    const diff = Math.abs(cmA - cmB);
    const diffIn = diff / 2.54;
    const diffFt = Math.floor(diffIn / 12);
    const remainingIn = (diffIn % 12).toFixed(1);

    const maxCm = Math.max(cmA, cmB, 1);
    const minCm = Math.min(cmA, cmB, 1);
    const pctDiff = ((diff / minCm) * 100).toFixed(1);

    const ftInA = cmToFtIn(cmA);
    const ftInB = cmToFtIn(cmB);

    if (diffHeadline) {
      if (diff === 0) {
        diffHeadline.textContent = sameHeadlineTpl;
      } else {
        diffHeadline.textContent = diffHeadlineTpl
          .replace('{diffCm}', diff.toFixed(1))
          .replace('{diffIn}', diffIn.toFixed(1));
      }
    }

    if (diffStatement) {
      if (diff === 0) {
        diffStatement.textContent = sameStmtTpl
          .replace('{nameA}', nameA)
          .replace('{nameB}', nameB)
          .replace('{cm}', String(cmA))
          .replace('{ftIn}', ftInA.formatted);
      } else if (cmA > cmB) {
        diffStatement.textContent = tallerStmtTpl
          .replace('{nameA}', nameA)
          .replace('{nameB}', nameB)
          .replace('{diffCm}', diff.toFixed(1))
          .replace('{diffIn}', diffIn.toFixed(1))
          .replace('{pctDiff}', pctDiff);
      } else {
        diffStatement.textContent = tallerStmtTpl
          .replace('{nameA}', nameB)
          .replace('{nameB}', nameA)
          .replace('{diffCm}', diff.toFixed(1))
          .replace('{diffIn}', diffIn.toFixed(1))
          .replace('{pctDiff}', pctDiff);
      }
    }

    if (statCm) statCm.textContent = `${diff.toFixed(1)} ${unitCm}`;
    if (statIn) statIn.textContent = `${diffIn.toFixed(1)} ${unitIn}`;
    if (statFt) statFt.textContent = `${diffFt}' ${remainingIn}"`;
    if (statPct) statPct.textContent = `${pctDiff}%`;

    // Update relative bars
    const barPctA = Math.round((cmA / maxCm) * 100);
    const barPctB = Math.round((cmB / maxCm) * 100);

    if (barLabelA) barLabelA.textContent = `${nameA}: ${cmA} ${unitCm} (${ftInA.formatted})`;
    if (barLabelB) barLabelB.textContent = `${nameB}: ${cmB} ${unitCm} (${ftInB.formatted})`;

    if (barValA) barValA.textContent = `${barPctA}%`;
    if (barValB) barValB.textContent = `${barPctB}%`;

    if (barA) barA.style.width = `${barPctA}%`;
    if (barB) barB.style.width = `${barPctB}%`;

    // Update CTA link
    if (compareLink) {
      const prefix = compareBase.endsWith('/') ? compareBase : `${compareBase}/`;
      compareLink.href = `${prefix}?h1=${Math.round(cmA)}&h2=${Math.round(cmB)}`;
    }
  }

  // Unit toggles
  document.querySelectorAll('.unit-toggle-a').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      unitModeA = target.dataset.unit || 'cm';
      document.querySelectorAll('.unit-toggle-a').forEach((b) => {
        b.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      target.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white');
      target.classList.remove('text-slate-600', 'dark:text-slate-300');

      const cmContainer = document.getElementById('input-a-cm-container');
      const ftContainer = document.getElementById('input-a-ft-container');
      if (unitModeA === 'cm') {
        cmContainer?.classList.remove('hidden');
        ftContainer?.classList.add('hidden');
      } else {
        cmContainer?.classList.add('hidden');
        ftContainer?.classList.remove('hidden');
      }
      recalculate();
    });
  });

  document.querySelectorAll('.unit-toggle-b').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      unitModeB = target.dataset.unit || 'cm';
      document.querySelectorAll('.unit-toggle-b').forEach((b) => {
        b.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      target.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white');
      target.classList.remove('text-slate-600', 'dark:text-slate-300');

      const cmContainer = document.getElementById('input-b-cm-container');
      const ftContainer = document.getElementById('input-b-ft-container');
      if (unitModeB === 'cm') {
        cmContainer?.classList.remove('hidden');
        ftContainer?.classList.add('hidden');
      } else {
        cmContainer?.classList.add('hidden');
        ftContainer?.classList.remove('hidden');
      }
      recalculate();
    });
  });

  // Listen to input changes
  [nameAInput, nameBInput, heightACmInput, heightAFtInput, heightAInInput, heightBCmInput, heightBFtInput, heightBInInput].forEach((el) => {
    el?.addEventListener('input', recalculate);
  });

  // Listen to quick comparison preset buttons
  document.querySelectorAll('.quick-matchup-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const nameA = target.dataset.nameA;
      const cmA = target.dataset.cmA;
      const nameB = target.dataset.nameB;
      const cmB = target.dataset.cmB;

      if (nameA && nameAInput) nameAInput.value = nameA;
      if (cmA && heightACmInput) {
        heightACmInput.value = cmA;
        if (unitModeA !== 'cm') {
          const cmBtn = document.querySelector('.unit-toggle-a[data-unit="cm"]') as HTMLButtonElement;
          cmBtn?.click();
        }
      }

      if (nameB && nameBInput) nameBInput.value = nameB;
      if (cmB && heightBCmInput) {
        heightBCmInput.value = cmB;
        if (unitModeB !== 'cm') {
          const cmBtn = document.querySelector('.unit-toggle-b[data-unit="cm"]') as HTMLButtonElement;
          cmBtn?.click();
        }
      }

      recalculate();
    });
  });

  recalculate();
</script>
