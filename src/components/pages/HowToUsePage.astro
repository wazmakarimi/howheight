---
import Layout from '../../layouts/Layout.astro';
import { getHowToGuide } from '../../data/howto';
import { getLocalizedPath, isRTL, t } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { SITE } from '../../config/site';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const guide = getHowToGuide(locale);
const isArabic = isRTL(locale);

const currentPath = getLocalizedPath('/how-to-use/', locale);
const canonicalUrl = `${SITE.siteUrl}${currentPath}`;

// Structured Data: BreadcrumbList + Article
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': t(locale, 'nav.home'),
      'item': `${SITE.siteUrl}${getLocalizedPath('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': guide.title,
      'item': canonicalUrl,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': guide.title,
  'description': guide.metaDescription,
  'image': SITE.defaultOgImage,
  'datePublished': '2024-09-19',
  'dateModified': '2026-09-24',
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  'author': {
    '@type': 'Person',
    'name': 'Firoz Khan',
    'jobTitle': 'Full Stack Developer',
    'url': `${SITE.siteUrl}/about/`,
    'sameAs': [
      'https://www.linkedin.com/in/firoz-khan-1153358a/',
      'https://github.com/fkdigitalmedia',
    ],
  },
  'publisher': {
    '@type': 'Organization',
    'name': SITE.name,
    'url': SITE.siteUrl,
    'logo': {
      '@type': 'ImageObject',
      'url': `${SITE.siteUrl}/favicon.svg`,
    },
  },
  'inLanguage': locale,
};
---

<Layout
  title={t(locale, 'howto.title')}
  description={t(locale, 'howto.desc')}
  canonicalUrl={canonicalUrl}
  locale={locale}
  suppressDefaultSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <article class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 ${isArabic ? 'text-right' : 'text-left'}`}>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="hover:text-brand-600 dark:hover:text-blue-400 transition-colors">
        {t(locale, 'nav.home')}
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-900 dark:text-white truncate" aria-current="page">
        {guide.title}
      </span>
    </nav>

    <!-- Header Section -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-brand-50 dark:bg-blue-950/50 text-brand-600 dark:text-blue-400 mb-4">
        <span>{guide.badge}</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span>{guide.readTime}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        {guide.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {guide.subtitle}
      </p>
    </header>

    <!-- Lead / Introduction -->
    <section class="mb-12">
      <p class="text-lg sm:text-xl font-medium text-slate-800 dark:text-slate-200 leading-relaxed mb-4">
        {guide.intro.lead}
      </p>
      {guide.intro.paragraphs.map((p) => (
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          {p}
        </p>
      ))}
    </section>

    <!-- Table of Contents -->
    <nav class="mb-14 p-6 sm:p-7 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 shadow-xs" aria-label="Table of Contents">
      <h2 class="text-base font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>{guide.tocTitle}</span>
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        {guide.sections.map((section) => (
          <li>
            <a href={`#${section.id}`} class="hover:text-brand-600 dark:hover:text-blue-400 hover:underline transition-colors block py-0.5">
              {section.heading}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- Core Sections (All 24 Topics) -->
    <div class="space-y-12 sm:space-y-14">
      {guide.sections.map((section) => (
        <section id={section.id} class="scroll-mt-24 pt-4 border-t border-slate-100 dark:border-slate-800/80">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
            {section.heading}
          </h2>

          <div class="space-y-3.5 text-slate-600 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>

          <!-- Step by Step Cards (if present) -->
          {section.steps && (
            <div class="grid grid-cols-1 gap-3.5 my-6">
              {section.steps.map((s) => (
                <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs flex items-start gap-4">
                  <span class="w-8 h-8 rounded-lg bg-brand-600 dark:bg-blue-500 text-white font-black text-sm flex items-center justify-center shrink-0">
                    {s.number}
                  </span>
                  <div>
                    <h3 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base">
                      {s.title}
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                      {s.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )}

          <!-- Callout Box (if present) -->
          {section.callout && (
            <div class={`my-5 p-4 rounded-xl border text-xs sm:text-sm flex items-start gap-3 ${
              section.callout.type === 'tip'
                ? 'bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/60 text-emerald-900 dark:text-emerald-300'
                : section.callout.type === 'note'
                ? 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/60 text-amber-900 dark:text-amber-300'
                : 'bg-blue-50 dark:bg-blue-950/30 border-blue-200 dark:border-blue-800/60 text-blue-900 dark:text-blue-300'
            }`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span class="leading-relaxed">{section.callout.text}</span>
            </div>
          )}

          <!-- Contextual Internal Link (if present) -->
          {section.link && (
            <div class="mt-4 pt-2">
              <a
                href={getLocalizedPath(section.link.href, locale)}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-600 dark:text-blue-400 hover:underline"
              >
                <span>{section.link.text}</span>
              </a>
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- FAQ Transition Section -->
    <div class="mt-16 p-8 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 dark:bg-blue-950 text-brand-600 dark:text-blue-400 mb-3">
        {guide.faqTransition.badge}
      </span>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        {guide.faqTransition.heading}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2 max-w-lg mx-auto leading-relaxed">
        {guide.faqTransition.text}
      </p>
      <div class="mt-5">
        <a
          href={`${getLocalizedPath('/', locale)}#faq`}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-600 border border-slate-200 dark:border-slate-600 transition-colors shadow-xs"
        >
          {guide.faqTransition.ctaText} →
        </a>
      </div>
    </div>

    <!-- Final Call to Action -->
    <div class="mt-10 p-8 sm:p-10 rounded-2xl bg-brand-600 dark:bg-brand-700 text-white text-center shadow-lg">
      <h3 class="text-2xl sm:text-3xl font-black tracking-tight">
        {guide.finalCta.heading}
      </h3>
      <p class="text-sm sm:text-base text-blue-100 mt-2 max-w-xl mx-auto leading-relaxed">
        {guide.finalCta.description}
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a
          href={getLocalizedPath(guide.finalCta.buttonHref, locale)}
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-bold bg-white text-brand-600 hover:bg-blue-50 transition-colors shadow-sm"
        >
          {guide.finalCta.buttonText}
        </a>
        <a
          href={getLocalizedPath(guide.finalCta.secondaryHref, locale)}
          class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 rounded-xl text-sm font-semibold text-blue-100 hover:text-white hover:bg-white/10 transition-colors"
        >
          {guide.finalCta.secondaryText}
        </a>
      </div>
    </div>
  </article>
</Layout>
