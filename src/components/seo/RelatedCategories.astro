---
import type { CategoryRelation } from '../../lib/internal-linking/types';
import CategoryIcon from '../brand/CategoryIcon.astro';
import { t } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  categories: CategoryRelation[];
  title?: string;
  subtitle?: string;
  locale?: Locale;
}

const {
  categories,
  title,
  subtitle,
  locale = 'en',
} = Astro.props;

const defaultTitle = t(locale, 'section.relatedCategories') || 'Explore Related Categories';
const defaultSubtitle = 'Discover complementary categories to expand your height perspective.';
const sectionTitle = title || defaultTitle;
const sectionSubtitle = subtitle || defaultSubtitle;
---

{categories && categories.length > 0 && (
  <section class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800">
    <div class="mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
        {t(locale, 'section.categoriesBadge') || 'Category Hubs'}
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight mt-2">
        {sectionTitle}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map((cat) => (
        <a
          href={cat.route}
          class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 group-hover:bg-brand-50 dark:group-hover:bg-brand-950/60 group-hover:text-brand-600 dark:group-hover:text-blue-400 flex items-center justify-center transition-colors">
                <CategoryIcon categoryId={cat.id} className="w-5 h-5" />
              </div>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">
                  {cat.badge}
                </span>
                <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors">
                  {cat.name}
                </h3>
              </div>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 mb-2 leading-relaxed">
              {cat.reason}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs font-bold text-brand-600 dark:text-blue-400">
            <span>{t(locale, 'action.browse') || 'Browse'} {cat.name}</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
