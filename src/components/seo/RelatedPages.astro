---
interface RelatedLink {
  title: string;
  url: string;
  subtitle?: string;
  tag?: string;
  color?: string;
}

interface Props {
  title?: string;
  description?: string;
  links: RelatedLink[];
}

const {
  title = 'Related Comparisons & Profiles',
  description = 'Explore additional height comparisons and verified dimensions.',
  links,
} = Astro.props;
---

{links && links.length > 0 && (
  <section class="mt-16 pt-10 border-t border-slate-200">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        {description}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
      {links.map((link) => (
        <a
          href={link.url}
          class="group p-4 rounded-2xl bg-white border border-slate-200/80 hover:border-brand-300 hover:shadow-soft-md transition-all flex flex-col justify-between"
        >
          <div class="flex items-start justify-between gap-2 mb-2">
            <span class="font-bold text-sm text-slate-900 group-hover:text-brand-600 transition-colors">
              {link.title}
            </span>
            {link.tag && (
              <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 flex-shrink-0">
                {link.tag}
              </span>
            )}
          </div>
          {link.subtitle && (
            <p class="text-xs text-slate-500 line-clamp-1">
              {link.subtitle}
            </p>
          )}
          <div class="flex items-center gap-1 text-xs font-semibold text-brand-600 mt-2.5">
            <span>View comparison</span>
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
