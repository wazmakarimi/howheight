---
import PersonForm from './PersonForm.astro';
import PeopleList from './PeopleList.astro';
import HeightChart from './HeightChart.astro';
import QuickCompare from './QuickCompare.astro';
import ComparisonSummary from './ComparisonSummary.astro';
import type { ComparisonItem } from '../lib/constants';
import type { Locale } from '../i18n/locales';

import { INITIAL_PEOPLE } from '../lib/constants';
import { resolveAsset } from '../data/assetRegistry';

interface Props {
  initialItems?: ComparisonItem[];
  initialComparisonSlug?: string;
  showQuickCompare?: boolean;
  locale?: Locale;
}

const { initialItems, initialComparisonSlug, showQuickCompare = true, locale = 'en' } = Astro.props;

// Server-side pre-resolve initial models so client does not need to bundle 1,400+ assets for initial render
const sourceItems = initialItems && initialItems.length > 0 ? initialItems : INITIAL_PEOPLE;
const resolvedItems = sourceItems.map((item) => {
  try {
    const rawLookup = item.assetId || (item as any).celebrityId || (item as any).animalType || (item as any).objectType || (item.category === 'human' ? (item as any).gender : item.id);
    const resolved = resolveAsset(rawLookup, item.category);
    return {
      ...item,
      assetId: resolved.id,
      name: item.name || resolved.name,
      heightCm: item.heightCm || resolved.heightCm || 175,
      referenceHeightCm: item.referenceHeightCm || resolved.heightCm || 175,
      publicPath: resolved.publicPath,
      viewBox: resolved.viewBox,
      measurementAnchor: resolved.measurementAnchor,
      isPng: Boolean(resolved.filename?.endsWith('.png') || resolved.publicPath?.endsWith('.png')),
    };
  } catch {
    return item;
  }
});
const initialItemsJson = JSON.stringify(resolvedItems);
---

<section 
  id="comparison-tool" 
  class="scroll-mt-20 w-full"
  data-initial-items={initialItemsJson}
  data-initial-slug={initialComparisonSlug}
>
  <div class="flex flex-col lg:flex-row gap-4 lg:gap-5 xl:gap-6 items-start w-full">
    <!-- Left Sidebar: Compact Asset Library & Controls (Desktop: ~220-250px) -->
    <aside class="w-full lg:w-[220px] xl:w-[240px] 2xl:w-[260px] shrink-0 space-y-4">
      <PersonForm locale={locale} />
      <PeopleList locale={locale} />
      {showQuickCompare && <QuickCompare locale={locale} />}
    </aside>

    <!-- Right Hero: Maximized Comparison Canvas & Insights (Takes all remaining width) -->
    <main class="flex-1 min-w-0 w-full space-y-4">
      <HeightChart locale={locale} />
      <ComparisonSummary locale={locale} />
    </main>
  </div>
</section>

<!-- Universal Interactive Engine Script (Bundled & Deduped by Astro) -->
<script src="../scripts/comparison-app.ts"></script>

