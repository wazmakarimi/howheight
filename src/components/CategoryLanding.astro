---
import Layout from '../layouts/Layout.astro';
import ComparisonTool from './ComparisonTool.astro';
import Breadcrumbs from './seo/Breadcrumbs.astro';
import FAQSection from './seo/FAQSection.astro';
import CategoryIcon from './brand/CategoryIcon.astro';
import RelatedComparisons from './seo/RelatedComparisons.astro';
import RelatedCategories from './seo/RelatedCategories.astro';
import type { CategoryDefinition } from '../data/categories';
import { CATEGORIES } from '../data/categories';
import { getAssetsByCategory } from '../data/assetRegistry';
import { CELEBRITIES } from '../data/celebrities';
import { SITE } from '../config/site';
import { cmToFeetInches } from '../lib/height';
import { getLocaleFromUrl, getLocalizedCategory, getLocalizedPath, getLocalizedEntityName, t } from '../i18n';
import type { Locale } from '../i18n/locales';
import {
  getEntityRoute,
  getSafeInternalUrl,
  getRelatedComparisons,
  getRelatedCategories,
} from '../lib/internal-linking';

interface Props {
  category: CategoryDefinition;
  locale?: Locale;
}

const { category: rawCategory, locale = getLocaleFromUrl(Astro.url) } = Astro.props;
const category = getLocalizedCategory(rawCategory, locale);

// Fetch verified assets for this category
let verifiedAssets = getAssetsByCategory(category.entityCategoryKey, true).filter(
  (a) => a.status === 'verified' && a.heightCm !== null
);

// If secondary key exists (e.g. female for people)
if (category.secondaryCategoryKey) {
  const secondaryAssets = getAssetsByCategory(category.secondaryCategoryKey, true).filter(
    (a) => a.status === 'verified' && a.heightCm !== null
  );
  verifiedAssets = [...verifiedAssets, ...secondaryAssets];
}

const isCelebrityCat = category.id === 'celebrities';

// Related categories via deterministic graph
const relatedCategories = getRelatedCategories(category.id, 3, locale);

// Filter comparisons related to this category via central engine
const relatedComparisons = getRelatedComparisons({
  category: category.id,
  limit: 6,
  locale,
});

const canonicalUrl = `${SITE.siteUrl}${getLocalizedPath(category.route, locale)}`;
---

<Layout
  title={category.title}
  description={category.description}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <div class="max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: 'Home', url: '/' },
        { name: category.name, url: category.route },
      ]}
    />

    <!-- Hero Header -->
    <header class="text-center max-w-4xl mx-auto my-6 sm:my-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200/80 mb-3 shadow-soft-sm">
        <CategoryIcon categoryId={category.id} className="w-4 h-4 text-brand-600" />
        <span>{category.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {category.h1}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed max-w-3xl mx-auto">
        {category.description}
      </p>
    </header>

    <!-- Interactive Comparison Workspace -->
    <section class="mb-16">
      <ComparisonTool locale={locale} />
    </section>

    <!-- Measurement Standards & Reference Table -->
    <section class="max-w-5xl mx-auto mb-16 p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 shadow-soft">
      <div class="max-w-3xl mb-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1 rounded-full">
          Measurement Standards
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
          How {category.name} Heights Are Measured
        </h2>
        <div class="mt-3 p-4 rounded-xl bg-slate-50 border border-slate-200/60 text-xs sm:text-sm text-slate-700 leading-relaxed space-y-2">
          <p><strong class="text-slate-900">Reference Anchor:</strong> {category.measurementAnchor}</p>
          <p>{category.measurementGuide}</p>
        </div>
      </div>

      <h3 class="text-base font-bold text-slate-900 mb-3">
        Common Reference Heights in {category.name}
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold">
              <th class="py-2.5 px-3">Subject / Benchmark</th>
              <th class="py-2.5 px-3">Metric Height</th>
              <th class="py-2.5 px-3">Imperial Height</th>
              <th class="py-2.5 px-3">Context &amp; Measurement Note</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            {category.commonHeights.map((item) => (
              <tr class="hover:bg-slate-50/60">
                <td class="py-2.5 px-3 font-semibold text-slate-900">{item.label}</td>
                <td class="py-2.5 px-3 font-bold text-slate-800">{item.heightCm} cm</td>
                <td class="py-2.5 px-3 font-medium text-slate-700">{item.imperial}</td>
                <td class="py-2.5 px-3 text-slate-500">{item.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Verified Entities Grid (Clean Entity Cards) -->
    {isCelebrityCat && (
      <section class="max-w-5xl mx-auto mb-16">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
              Verified Celebrities Directory
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Confirmed stature archives with documented athletic combine and biography data.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
          {CELEBRITIES.map((celeb) => {
            const ft = cmToFeetInches(celeb.heightCm);
            const localizedName = getLocalizedEntityName(celeb.slug, celeb.name, locale);
            return (
              <a
                href={getSafeInternalUrl(`/celebrity-height/${celeb.slug}/`, locale)}
                class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all group flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                    <span class="font-bold text-brand-700 dark:text-blue-400 uppercase truncate">{celeb.profession}</span>
                    <span>{celeb.country}</span>
                  </div>
                  <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors truncate">
                    {localizedName}
                  </h3>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs">
                  <span class="font-bold text-slate-800 dark:text-slate-200">{ft.formatted}</span>
                  <span class="text-slate-500 dark:text-slate-400 font-medium">{celeb.heightCm} cm</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {!isCelebrityCat && verifiedAssets.length > 0 && (
      <section class="max-w-5xl mx-auto mb-16">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              Verified {category.name} Catalog
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
              Accurately scaled vector and raster figures ready for side-by-side comparison.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
          {verifiedAssets.slice(0, 32).map((asset) => {
            const ft = asset.heightCm ? cmToFeetInches(asset.heightCm) : null;
            const entityRoute = getEntityRoute(category.entityCategoryKey, asset.slug || asset.id);
            const cardUrl = entityRoute ? getSafeInternalUrl(entityRoute, locale) : getSafeInternalUrl('/compare/', locale);
            const localizedName = getLocalizedEntityName(asset.id, asset.name, locale);

            return (
              <a
                href={cardUrl}
                class="p-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all flex flex-col justify-between group"
              >
                <div>
                  <div class="h-28 w-full flex items-center justify-center p-2 mb-2 bg-slate-50 dark:bg-slate-900/60 rounded-xl">
                    <img
                      src={asset.publicPath}
                      alt={localizedName}
                      class="max-h-full max-w-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase">{category.name}</span>
                  <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-blue-400 transition-colors truncate">
                    {localizedName}
                  </h3>
                </div>
                <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs">
                  {asset.heightCm ? (
                    <>
                      <span class="font-bold text-slate-800 dark:text-slate-200">{ft?.formatted}</span>
                      <span class="text-slate-500 dark:text-slate-400 font-medium">{asset.heightCm} cm</span>
                    </>
                  ) : (
                    <span class="text-[11px] text-slate-400 italic">Height unavailable</span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Related Curated Comparisons -->
    {relatedComparisons.length > 0 && (
      <div class="max-w-5xl mx-auto mb-16">
        <RelatedComparisons
          comparisons={relatedComparisons}
          title={`Popular ${category.name} Comparisons`}
          locale={locale}
        />
      </div>
    )}

    <!-- Related Category Hubs -->
    {relatedCategories.length > 0 && (
      <div class="max-w-5xl mx-auto mb-16">
        <RelatedCategories
          categories={relatedCategories}
          locale={locale}
        />
      </div>
    )}

    <!-- Category FAQs -->
    <section class="max-w-4xl mx-auto mb-16">
      <FAQSection
        title={`${category.name} Height Comparison FAQ`}
        faqs={category.faqs}
      />
    </section>

    <!-- Internal Linking Hub -->
    <section class="max-w-5xl mx-auto pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4">
        Explore More Categories &amp; Utilities
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {CATEGORIES.filter((c) => c.id !== category.id).slice(0, 4).map((c) => (
          <a
            href={getSafeInternalUrl(c.route, locale)}
            class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-all text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-blue-400 flex items-center gap-2 group"
          >
            <CategoryIcon categoryId={c.id} className="w-4 h-4 text-slate-400 group-hover:text-brand-600" />
            <span>{c.name} Height</span>
          </a>
        ))}
        <a
          href={getSafeInternalUrl('/height-comparison-calculator/', locale)}
          class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-all text-xs font-semibold text-brand-600 dark:text-blue-400 flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/>
            <path d="m14.5 12.5 2-2"/>
            <path d="m11.5 9.5 2-2"/>
            <path d="m8.5 6.5 2-2"/>
            <path d="m17.5 15.5 2-2"/>
          </svg>
          <span>Difference Calculator</span>
        </a>
        <a
          href={getSafeInternalUrl('/height-comparison-chart/', locale)}
          class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-all text-xs font-semibold text-brand-600 dark:text-blue-400 flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
          <span>Comparison Chart</span>
        </a>
        <a
          href={getSafeInternalUrl('/how-to-use/', locale)}
          class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-all text-xs font-semibold text-brand-600 dark:text-blue-400 flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <span>How to Use</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
