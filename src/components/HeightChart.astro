---
import HeightRuler from './HeightRuler.astro';
import { t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-soft p-3.5 sm:p-5 flex flex-col">
  <!-- Chart Controls & Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">{t(locale, 'canvas.title')}</h2>
        <span id="chart-total-count" class="hidden sm:inline-flex px-2 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700">
          3 Items
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Accurate, proportional visual comparison for humans and animals on an aligned baseline.
      </p>
    </div>

    <!-- Chart Action Buttons -->
    <div class="flex items-center flex-wrap gap-2">
      <!-- Sort Select -->
      <div class="flex items-center gap-1.5 text-xs text-slate-600 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5">
        <span class="font-medium text-slate-500">Sort:</span>
        <select id="sort-selector" class="bg-transparent font-semibold text-slate-800 focus:outline-none cursor-pointer">
          <option value="added">Added Order</option>
          <option value="height-asc">Height: Low → High</option>
          <option value="height-desc">Height: High → Low</option>
        </select>
      </div>

      <!-- Ruler Unit Selector -->
      <div class="flex items-center bg-slate-100 p-0.5 rounded-lg text-xs font-medium">
        <button 
          type="button" 
          id="ruler-toggle-cm" 
          class="px-2 py-1 rounded-md transition-all font-bold text-brand-600 bg-white shadow-soft-sm"
          data-ruler-unit="cm"
          title="Show ruler in centimeters"
        >
          cm
        </button>
        <button 
          type="button" 
          id="ruler-toggle-ft" 
          class="px-2 py-1 rounded-md transition-all text-slate-600 hover:text-slate-900"
          data-ruler-unit="ft"
          title="Show ruler in feet and inches"
        >
          ft / in
        </button>
      </div>

      <!-- Undo / Redo Buttons -->
      <div class="flex items-center bg-slate-100 p-0.5 rounded-lg text-xs font-medium">
        <button
          type="button"
          id="undo-btn"
          disabled
          class="p-1.5 rounded-md text-slate-400 hover:text-slate-700 disabled:opacity-40 disabled:pointer-events-none transition-colors"
          title="Undo last change (Ctrl+Z)"
          aria-label="Undo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M3 7v6h6"></path>
            <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path>
          </svg>
        </button>
        <button
          type="button"
          id="redo-btn"
          disabled
          class="p-1.5 rounded-md text-slate-400 hover:text-slate-700 disabled:opacity-40 disabled:pointer-events-none transition-colors"
          title="Redo last change (Ctrl+Y)"
          aria-label="Redo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 7v6h-6"></path>
            <path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"></path>
          </svg>
        </button>
      </div>

      <!-- Canvas Zoom Controls -->
      <div class="flex items-center bg-slate-100 p-0.5 rounded-lg text-xs font-medium">
        <button
          type="button"
          id="zoom-out-btn"
          class="px-2 py-1 rounded-md text-slate-600 hover:text-slate-900 transition-colors"
          title="Zoom out visual stage"
        >
          −
        </button>
        <span id="zoom-label" class="px-1.5 text-[11px] font-bold text-slate-700 select-none">100%</span>
        <button
          type="button"
          id="zoom-in-btn"
          class="px-2 py-1 rounded-md text-slate-600 hover:text-slate-900 transition-colors"
          title="Zoom in visual stage"
        >
          +
        </button>
        <button
          type="button"
          id="zoom-reset-btn"
          class="px-1.5 py-1 text-[10px] text-slate-400 hover:text-slate-700 rounded transition-colors"
          title="Reset zoom to 100%"
        >
          Reset
        </button>
      </div>

      <!-- Layout Controls: Fit All & Reset Positions -->
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="fit-all-btn"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Evenly distribute all comparison models across the canvas"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span>{t(locale, 'canvas.fit')}</span>
        </button>
        <button
          type="button"
          id="reset-positions-btn"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Reset all models to automatic horizontal layout"
        >
          <span>Auto Layout</span>
        </button>
      </div>

      <!-- Action: Draw Mode Toggle -->
      <button
        type="button"
        id="toggle-draw-mode-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
        title="Draw or annotate directly on the comparison canvas"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        <span id="draw-btn-text">{t(locale, 'canvas.draw')}</span>
      </button>

      <!-- Action: Share -->
      <button
        type="button"
        id="share-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
        title={t(locale, 'canvas.share')}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span id="share-btn-text">{t(locale, 'action.share')}</span>
      </button>

      <!-- Action: Download PNG -->
      <button
        type="button"
        id="download-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
        title={t(locale, 'canvas.exportPng')}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t(locale, 'canvas.exportPng')}</span>
      </button>

      <!-- Action: Reset -->
      <button
        type="button"
        id="reset-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-600 text-xs font-semibold shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
        title={t(locale, 'canvas.reset')}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        <span>{t(locale, 'action.reset')}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Drag & Resize Hint Banner -->
  <div id="interaction-hint-banner" class="mt-3 py-2 px-3 rounded-xl bg-purple-50/80 border border-purple-200/70 flex items-center justify-between text-xs text-purple-900 transition-all">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse flex-shrink-0"></span>
      <span>
        <strong>Interactive Controls:</strong> Drag models horizontally to reposition • Drag top handle vertically to resize physical height • Use arrow keys for ±1 cm.
      </span>
    </div>
    <button
      type="button"
      id="dismiss-hint-btn"
      class="text-purple-600 hover:text-purple-950 font-bold p-1 rounded hover:bg-purple-100 transition-colors ml-2"
      aria-label="Dismiss hint"
      title="Dismiss hint"
    >
      ✕
    </button>
  </div>

  <!-- Selected Entity Precision Toolbar (shown when an item is selected) -->
  <div id="selection-precision-toolbar" class="hidden mt-3 p-3 rounded-xl bg-slate-900 text-white shadow-soft-md flex flex-wrap items-center justify-between gap-3 animate-fadeIn">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-3 h-3 rounded-full flex-shrink-0 shadow-sm" id="selected-item-color-dot" style="background-color: #2563eb;"></div>
      <div class="truncate flex items-center gap-2">
        <span id="selected-item-name" class="font-bold text-sm text-white truncate">John</span>
        <span id="selected-item-badge" class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-white/20 text-slate-200">HUMAN</span>
        <span id="selected-custom-badge" class="hidden text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-amber-400 text-slate-950">CUSTOM HEIGHT</span>
      </div>
    </div>

    <!-- Precision Controls -->
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Height adjustment: [- 1 cm] [value] [+ 1 cm] -->
      <div class="flex items-center bg-slate-800 rounded-lg p-0.5 border border-slate-700">
        <button
          type="button"
          id="nudge-down-btn"
          class="px-2 py-1 text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-700 rounded transition-colors"
          title="Decrease height by 1 cm (Down Arrow)"
        >
          − 1 cm
        </button>
        <span id="selected-height-display" class="px-2.5 py-1 text-xs font-black text-brand-300 min-w-[70px] text-center select-none">
          180 cm
        </span>
        <button
          type="button"
          id="nudge-up-btn"
          class="px-2 py-1 text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-700 rounded transition-colors"
          title="Increase height by 1 cm (Up Arrow)"
        >
          + 1 cm
        </button>
      </div>

      <!-- Horizontal Position Nudge: [←] [→] -->
      <div class="flex items-center bg-slate-800 rounded-lg p-0.5 border border-slate-700">
        <button
          type="button"
          id="nudge-left-btn"
          class="px-2 py-1 text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-700 rounded transition-colors"
          title="Move model left (Left Arrow)"
        >
          ←
        </button>
        <button
          type="button"
          id="nudge-right-btn"
          class="px-2 py-1 text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-700 rounded transition-colors"
          title="Move model right (Right Arrow)"
        >
          →
        </button>
      </div>

      <!-- Reset Height (visible when custom) -->
      <button
        type="button"
        id="reset-selected-height-btn"
        class="hidden px-2.5 py-1 text-xs font-semibold text-amber-300 hover:text-amber-200 bg-amber-950/60 hover:bg-amber-900/80 border border-amber-500/40 rounded-lg transition-colors"
        title="Restore original reference height"
      >
        ↺ Reset Height
      </button>

      <!-- Deselect Button -->
      <button
        type="button"
        id="deselect-btn"
        class="p-1 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors"
        title="Deselect (Escape)"
        aria-label="Deselect"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Floating Canvas Drawing Toolbar (Active when Draw Mode is ON) -->
  <div 
    id="canvas-drawing-toolbar" 
    class="hidden mt-3 p-2.5 rounded-xl bg-slate-900 text-white shadow-soft-lg flex flex-wrap items-center justify-between gap-3 animate-fadeIn border border-slate-700/60"
  >
    <div class="flex items-center gap-2 flex-wrap">
      <div class="flex items-center gap-1 bg-slate-800 p-0.5 rounded-lg border border-slate-700">
        <!-- Pen -->
        <button
          type="button"
          id="draw-tool-pen"
          class="draw-tool-btn px-2.5 py-1 text-xs font-bold rounded-md transition-all bg-brand-600 text-white shadow-sm flex items-center gap-1.5"
          data-tool="pen"
          title="Pencil / Pen (P)"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <span>Pen</span>
        </button>
        <!-- Highlighter -->
        <button
          type="button"
          id="draw-tool-highlighter"
          class="draw-tool-btn px-2.5 py-1 text-xs font-semibold rounded-md transition-all text-slate-300 hover:text-white hover:bg-slate-700 flex items-center gap-1.5"
          data-tool="highlighter"
          title="Semi-transparent Highlighter (H)"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 11-6 6v3h3l6-6"></path><path d="m22 2-7 7 4 4 7-7z"></path></svg>
          <span>Highlight</span>
        </button>
        <!-- Move / Drag Drawing -->
        <button
          type="button"
          id="draw-tool-move"
          class="draw-tool-btn px-2.5 py-1 text-xs font-semibold rounded-md transition-all text-slate-300 hover:text-white hover:bg-slate-700 flex items-center gap-1.5"
          data-tool="move"
          title="Drag / Move Drawings (M or Hold Space)"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="5 9 2 12 5 15"></polyline>
            <polyline points="9 5 12 2 15 5"></polyline>
            <polyline points="15 19 12 22 9 19"></polyline>
            <polyline points="19 9 22 12 19 15"></polyline>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <line x1="12" y1="2" x2="12" y2="22"></line>
          </svg>
          <span>Move / Drag</span>
        </button>
        <!-- Eraser -->
        <button
          type="button"
          id="draw-tool-eraser"
          class="draw-tool-btn px-2.5 py-1 text-xs font-semibold rounded-md transition-all text-slate-300 hover:text-white hover:bg-slate-700 flex items-center gap-1.5"
          data-tool="eraser"
          title="Eraser (E)"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"></path><path d="M22 21H7"></path><path d="m5 11 9 9"></path></svg>
          <span>Eraser</span>
        </button>
      </div>

      <!-- Color Palette -->
      <div class="flex items-center gap-1.5 bg-slate-800 px-2 py-1 rounded-lg border border-slate-700" id="draw-color-palette">
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border-2 border-brand-400 scale-110 shadow-sm transition-transform" style="background-color: #2563eb;" data-color="#2563eb" title="Blue"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #ef4444;" data-color="#ef4444" title="Red"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #10b981;" data-color="#10b981" title="Green"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #f59e0b;" data-color="#f59e0b" title="Amber"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #8b5cf6;" data-color="#8b5cf6" title="Purple"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #0f172a;" data-color="#0f172a" title="Dark"></button>
        <button type="button" class="draw-color-btn w-5 h-5 rounded-full border border-slate-600 hover:scale-110 shadow-sm transition-transform" style="background-color: #ffffff;" data-color="#ffffff" title="White"></button>
      </div>

      <!-- Brush Size -->
      <div class="flex items-center gap-1 bg-slate-800 p-0.5 rounded-lg border border-slate-700 text-xs text-slate-300">
        <span class="text-[10px] uppercase font-bold text-slate-400 px-1">Size:</span>
        <button type="button" class="draw-size-btn px-2.5 py-0.5 rounded text-xs font-bold text-white bg-slate-700" data-size="3" title="Fine">S</button>
        <button type="button" class="draw-size-btn px-2.5 py-0.5 rounded text-xs font-semibold text-slate-400 hover:text-white" data-size="6" title="Medium">M</button>
        <button type="button" class="draw-size-btn px-2.5 py-0.5 rounded text-xs font-semibold text-slate-400 hover:text-white" data-size="12" title="Thick">L</button>
      </div>

      <!-- Helper Tip -->
      <div id="draw-helper-hint" class="hidden lg:flex items-center gap-1.5 text-xs text-amber-300 bg-amber-950/60 border border-amber-500/30 px-2.5 py-1 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>Tip: Click <strong>Move / Drag</strong> to grab & reposition drawings</span>
      </div>
    </div>

    <!-- Actions: Undo, Clear, Done -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="draw-undo-btn"
        class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold border border-slate-700 flex items-center gap-1 transition-colors"
        title="Undo last stroke"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
        <span>Undo</span>
      </button>

      <button
        type="button"
        id="draw-clear-btn"
        class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-rose-900/60 text-slate-300 hover:text-rose-200 text-xs font-semibold border border-slate-700 hover:border-rose-700/60 flex items-center gap-1 transition-colors"
        title="Clear all drawings"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        <span>Clear</span>
      </button>

      <button
        type="button"
        id="draw-done-btn"
        class="px-3 py-1 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-soft-sm transition-colors"
        title="Finish drawing and return to figure controls"
      >
        Done
      </button>
    </div>
  </div>

  <!-- Measurement Reference Informational Note -->
  <div class="mt-3 py-1.5 px-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-2 text-[11px] text-slate-500">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
    <span>
      <strong>Measurement Reference:</strong> Four-legged animals are measured to the shoulder or withers. Heads and ears naturally extend above the shoulder line.
    </span>
  </div>

  <!-- Height Difference Card (when exactly 2 entities are active) -->
  <div id="height-difference-card" class="hidden mt-4 p-4 rounded-xl bg-gradient-to-r from-brand-50 via-indigo-50/40 to-slate-50 border border-brand-100 transition-all">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-soft-sm flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
        </div>
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-brand-700">Height Difference Analysis</span>
          <p id="diff-statement" class="text-sm sm:text-base font-extrabold text-slate-900 leading-snug">
            <!-- Dynamic statement -->
          </p>
        </div>
      </div>
      <!-- Metric & Imperial Pill -->
      <div class="flex items-center gap-2 self-start sm:self-center">
        <div class="px-3 py-1.5 rounded-lg bg-white border border-brand-200 shadow-soft-sm text-xs font-bold text-brand-800" id="diff-badge-imperial">
          <!-- e.g. 4 inches -->
        </div>
        <div class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-soft-sm text-xs font-semibold text-slate-600" id="diff-badge-metric">
          <!-- e.g. 10.2 cm -->
        </div>
      </div>
    </div>
  </div>

  <!-- Visual Chart Canvas / Viewport -->
  <div class="relative mt-4 pt-2 pb-2 select-none">
    <!-- Chart Scroll Container (Horizontal scroll for small screens or many items) -->
    <div 
      id="chart-viewport" 
      class="relative overflow-x-auto custom-scrollbar flex items-end min-h-[560px] h-[clamp(560px,72vh,800px)] border border-slate-200/80 rounded-2xl bg-gradient-to-b from-slate-50/70 via-white to-slate-50/40 px-1 sm:px-4"
    >
      <!-- Fixed / Sticky Ruler on the left -->
      <div class="sticky left-0 z-20 flex-shrink-0 h-full flex flex-col justify-end bg-white/90 backdrop-blur-sm border-r border-slate-200/80 shadow-soft-sm rounded-l-xl">
        <HeightRuler />
      </div>

      <!-- Models Stage -->
      <div id="models-stage" class="relative flex-1 flex items-end min-w-[360px] h-full pl-3 sm:pl-6 pr-4">
        <!-- Subtle Horizontal Grid Lines across stage -->
        <div id="chart-grid-lines" class="absolute inset-0 pointer-events-none z-0"></div>

        <!-- Models Container (standing on baseline) -->
        <div id="models-container" class="relative z-10 flex items-end justify-around w-full h-full pb-0 mb-[36px]">
          <!-- Human and Animal SVG models injected here by client JS -->
        </div>

        <!-- Interactive Drawing / Sketch Overlay Canvas -->
        <canvas id="drawing-canvas" class="absolute inset-0 z-20 pointer-events-none w-full h-full"></canvas>

        <!-- Aligned Fixed Baseline Floor Line -->
        <div class="absolute left-0 right-0 bottom-[36px] z-10 pointer-events-none flex items-center">
          <div class="w-full h-1.5 bg-slate-800 rounded-full shadow-sm"></div>
          <div class="absolute left-2 -bottom-5 text-[10px] font-bold uppercase tracking-wider text-slate-500">
            0 cm / Floor Baseline
          </div>
        </div>
      </div>

      <!-- Empty State Container (shown when items list is empty) -->
      <div id="chart-empty-state" class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center p-6 bg-white/95 rounded-2xl text-center">
        <!-- Lightweight Inline SVG illustration -->
        <div class="w-20 h-20 mb-4 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <line x1="19" y1="8" x2="19" y2="14"></line>
            <line x1="22" y1="11" x2="16" y2="11"></line>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">Compare Heights Visually</h3>
        <p class="text-sm text-slate-500 max-w-sm mb-5">
          Add humans or animals to see how their physical heights compare with accurate proportional scale.
        </p>
        <button
          type="button"
          id="empty-add-person-btn"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm text-white bg-brand-600 hover:bg-brand-700 shadow-soft-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add First Item
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Model Tooltip (Populated dynamically on hover / tap) -->
  <div 
    id="chart-tooltip" 
    class="pointer-events-none fixed z-50 hidden -translate-x-1/2 -translate-y-full px-3 py-2 bg-slate-900/95 text-white text-xs rounded-xl shadow-soft-lg backdrop-blur-sm transition-opacity duration-150"
    role="tooltip"
  >
    <div id="tooltip-name" class="font-bold text-white text-sm"></div>
    <div id="tooltip-details" class="text-slate-300 text-[11px] mt-0.5"></div>
    <div class="absolute left-1/2 -bottom-1 -translate-x-1/2 w-2 h-2 bg-slate-900 rotate-45"></div>
  </div>
</div>
