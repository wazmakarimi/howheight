---
import BrandMark from './BrandMark.astro';

interface Props {
  showTagline?: boolean;
  size?: 'sm' | 'md' | 'lg';
  className?: string;
  iconOnly?: boolean;
}

const { showTagline = false, size = 'md', className = '', iconOnly = false } = Astro.props;

const textSizes = {
  sm: 'text-base',
  md: 'text-xl',
  lg: 'text-2xl',
}[size];
---

<a href="/" class={`inline-flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-xl py-1 px-1 transition-all ${className}`} aria-label="HowHeight Homepage">
  <BrandMark size={size} />

  {!iconOnly && (
    <div class="flex flex-col">
      <span class={`font-black text-slate-900 dark:text-white tracking-tight leading-none ${textSizes}`}>
        How<span class="text-brand-600 dark:text-blue-400">Height</span>
      </span>
      {showTagline && (
        <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 tracking-wider uppercase mt-1">
          Compare Anything by Height
        </span>
      )}
    </div>
  )}
</a>
