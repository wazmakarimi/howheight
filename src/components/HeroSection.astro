---
import { getLocaleFromUrl, getLocalizedPath, t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;
---

<section class="max-w-5xl mx-auto text-center pt-6 sm:pt-10 pb-8 sm:pb-12">
  <!-- Subtle Badge -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-blue-300 border border-brand-200/80 dark:border-brand-800/60 mb-5 shadow-soft-sm">
    <span class="w-2 h-2 rounded-full bg-brand-600 dark:bg-blue-400 animate-pulse"></span>
    <span>{t(locale, 'hero.badge')}</span>
  </div>

  <!-- Primary H1 -->
  <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
    {t(locale, 'hero.title')}
  </h1>

  <!-- Supporting text -->
  <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-4 leading-relaxed max-w-3xl mx-auto">
    {t(locale, 'hero.description')}
  </p>

  <!-- Primary & Secondary CTAs -->
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
    <a
      href={getLocalizedPath('/compare/', locale)}
      class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-bold text-sm sm:text-base text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 shadow-soft transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
    >
      {t(locale, 'hero.startComparing')}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a
      href="#categories"
      class="inline-flex items-center justify-center px-5 py-3 rounded-lg font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 shadow-soft-sm transition-all"
    >
      {t(locale, 'hero.exploreComparisons')}
    </a>
  </div>

  <!-- Product Preview Graphic: Communicates Height Difference with ruler, baseline, silhouettes & height labels -->
  <div class="mt-10 max-w-3xl mx-auto p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 shadow-soft">
    <div class="flex items-center justify-between text-xs text-slate-400 font-semibold mb-3 border-b border-slate-100 dark:border-slate-700/60 pb-2">
      <span class="flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{t(locale, 'hero.previewTitle')}</span>
      </span>
      <span class="text-[11px] text-slate-400">{t(locale, 'hero.baselineFloor')}</span>
    </div>

    <div class="relative h-56 sm:h-64 w-full flex items-end justify-center px-4 overflow-hidden bg-slate-50/70 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800">
      <!-- Background Grid lines -->
      <div class="absolute inset-0 flex flex-col justify-between pointer-events-none opacity-25 dark:opacity-20">
        <div class="border-b border-slate-300 dark:border-slate-600 w-full h-full"></div>
        <div class="border-b border-slate-300 dark:border-slate-600 w-full h-full"></div>
        <div class="border-b border-slate-300 dark:border-slate-600 w-full h-full"></div>
      </div>

      <!-- Vertical Ruler (Left) -->
      <div class="absolute left-3 sm:left-6 bottom-3 top-4 flex flex-col justify-between items-end pr-2 border-r-2 border-slate-300 dark:border-slate-600 text-[10px] font-bold text-slate-400">
        <div class="flex items-center gap-1"><span>210 cm</span><span class="w-2 h-0.5 bg-slate-400"></span></div>
        <div class="flex items-center gap-1"><span>180 cm</span><span class="w-2 h-0.5 bg-brand-500"></span></div>
        <div class="flex items-center gap-1"><span>160 cm</span><span class="w-2 h-0.5 bg-indigo-500"></span></div>
        <div class="flex items-center gap-1"><span>60 cm</span><span class="w-2 h-0.5 bg-slate-400"></span></div>
        <div class="flex items-center gap-1 text-brand-600 dark:text-blue-400"><span>0 cm</span><span class="w-3 h-0.5 bg-brand-600"></span></div>
      </div>

      <!-- Comparison Scene Figures -->
      <div class="relative flex items-end justify-center gap-4 sm:gap-10 pb-3 z-10 pl-16">
        <!-- Figure 1: Door / Structure (210 cm) -->
        <div class="flex flex-col items-center group">
          <span class="text-[11px] font-black text-slate-700 dark:text-slate-300 mb-1 px-1.5 py-0.5 bg-white dark:bg-slate-800 rounded shadow-xs border border-slate-200 dark:border-slate-700">210 cm</span>
          <div class="w-10 sm:w-14 h-44 sm:h-52 bg-slate-200 dark:bg-slate-700 rounded-t-md border-2 border-slate-300 dark:border-slate-600 flex items-center justify-center">
            <span class="text-[9px] font-bold text-slate-400 uppercase rotate-90">{t(locale, 'hero.itemDoor')}</span>
          </div>
        </div>

        <!-- Figure 2: Tall Human (180 cm) -->
        <div class="flex flex-col items-center group">
          <span class="text-[11px] font-black text-brand-600 dark:text-blue-400 mb-1 px-1.5 py-0.5 bg-white dark:bg-slate-800 rounded shadow-xs border border-brand-200 dark:border-brand-800">180 cm</span>
          <div class="w-9 sm:w-12 h-38 sm:h-44 bg-brand-600 dark:bg-blue-500 rounded-t-full relative flex flex-col items-center shadow-soft">
            <div class="w-5 h-5 rounded-full bg-brand-700 dark:bg-blue-600 mt-1"></div>
            <span class="text-[9px] font-bold text-white mt-auto mb-2">{t(locale, 'hero.itemHuman')}</span>
          </div>
        </div>

        <!-- Figure 3: Average Human (160 cm) -->
        <div class="flex flex-col items-center group">
          <span class="text-[11px] font-black text-indigo-600 dark:text-indigo-400 mb-1 px-1.5 py-0.5 bg-white dark:bg-slate-800 rounded shadow-xs border border-indigo-200 dark:border-indigo-800">160 cm</span>
          <div class="w-8 sm:w-11 h-34 sm:h-38 bg-indigo-500 dark:bg-indigo-600 rounded-t-full relative flex flex-col items-center shadow-soft">
            <div class="w-4 h-4 rounded-full bg-indigo-600 dark:bg-indigo-700 mt-1"></div>
            <span class="text-[9px] font-bold text-white mt-auto mb-2">{t(locale, 'hero.itemHuman')}</span>
          </div>
        </div>

        <!-- Figure 4: Quadruped Animal (60 cm) -->
        <div class="flex flex-col items-center group">
          <span class="text-[11px] font-black text-amber-600 dark:text-amber-400 mb-1 px-1.5 py-0.5 bg-white dark:bg-slate-800 rounded shadow-xs border border-amber-200 dark:border-amber-800">60 cm</span>
          <div class="w-12 sm:w-16 h-14 sm:h-16 bg-amber-500 rounded-t-lg flex items-center justify-center shadow-soft text-white font-bold text-[9px]">
            {t(locale, 'hero.itemDog')}
          </div>
        </div>
      </div>

      <!-- Floor Baseline Line (0 cm) -->
      <div class="absolute bottom-3 left-0 right-0 h-1 bg-gradient-to-r from-brand-600 via-blue-500 to-indigo-600"></div>
    </div>
  </div>
</section>
