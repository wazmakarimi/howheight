---
---

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-soft p-3.5 sm:p-4">
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <h3 class="font-bold text-slate-900 text-sm">Compared Items</h3>
      <span id="people-count-badge" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
        3
      </span>
    </div>
    <button 
      type="button" 
      id="clear-all-btn" 
      class="text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-2 py-1 rounded transition-colors"
      title="Remove all items"
    >
      Clear All
    </button>
  </div>

  <!-- Dynamic Items Container -->
  <div id="people-list-container" class="space-y-2.5 max-h-[360px] overflow-y-auto pr-1 custom-scrollbar">
    <!-- Populated dynamically by client script -->
  </div>

  <!-- Empty list hint (hidden when items exist) -->
  <div id="people-list-empty" class="hidden py-8 text-center text-xs text-slate-400">
    No comparison items added yet. Use the form above to add humans, animals, objects, or celebrities.
  </div>
</div>
