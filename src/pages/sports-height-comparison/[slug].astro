---
import Layout from '../../layouts/Layout.astro';
import ComparisonTool from '../../components/ComparisonTool.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ComparisonIntro from '../../components/seo/ComparisonIntro.astro';
import { ASSET_REGISTRY, type AssetMetadata } from '../../data/assetRegistry';
import { cmToFeetInches } from '../../lib/height';
import { SITE } from '../../config/site';
import type { ComparisonItem } from '../../lib/constants';

export function getStaticPaths() {
  const verifiedSports = ASSET_REGISTRY.filter(
    (a) => a.category === 'sports' && a.status === 'verified' && a.heightCm !== null && a.indexable !== false
  ).slice(0, 25);

  return verifiedSports.map((sport) => ({
    params: { slug: sport.slug },
    props: { sport },
  }));
}

interface Props {
  sport: AssetMetadata;
}

const { sport } = Astro.props;
const sportHeight = sport.heightCm || 100;
const ftIn = cmToFeetInches(sportHeight);
const canonical = `${SITE.siteUrl}/sports-height-comparison/${sport.slug}/`;

const initialItems: ComparisonItem[] = [
  {
    id: `seo-sport-${sport.id}`,
    category: 'sports',
    assetId: sport.id,
    name: sport.name,
    heightCm: sportHeight,
    referenceHeightCm: sportHeight,
    isCustomHeight: false,
    color: '#ea580c',
  },
  {
    id: 'seo-human-ref',
    category: 'human',
    name: 'Average Human (176 cm)',
    gender: 'male',
    heightCm: 176,
    referenceHeightCm: 176,
    isCustomHeight: false,
    color: '#2563eb',
  },
];

import RelatedEntities from '../../components/seo/RelatedEntities.astro';
import RelatedComparisons from '../../components/seo/RelatedComparisons.astro';
import RelatedCategories from '../../components/seo/RelatedCategories.astro';
import {
  getRelatedEntities,
  getRelatedComparisons,
  getRelatedCategories,
} from '../../lib/internal-linking';

// Related sports items via deterministic scoring
const relatedEntities = getRelatedEntities(
  {
    id: sport.id,
    category: 'sports',
    name: sport.name,
    heightCm: sportHeight,
    tags: sport.tags,
  },
  8,
  'en'
);

// Curated matchups featuring athletes or sports gear
const relatedComparisons = getRelatedComparisons({
  entityId: sport.id,
  category: 'sports',
  limit: 6,
  locale: 'en',
});

// Category relationships
const relatedCategories = getRelatedCategories('sports', 3, 'en');
---

<Layout
  title={`${sport.name} Height – Height Comparison | ${SITE.name}`}
  description={`Compare ${sport.name} height (${sportHeight} cm / ${ftIn.formatted}) with athletes, human figures, and basketball rims side-by-side with HowHeight.`}
  canonicalUrl={canonical}
>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Sports Height Comparison', url: '/sports-height-comparison/' },
        { name: sport.name, url: `/sports-height-comparison/${sport.slug}/` },
      ]}
    />

    <ComparisonIntro
      h1={`${sport.name} Height Comparison`}
      badge="Athletic Regulation Scale"
      badgeColor="amber"
      introText={`Athletic regulation scale comparison for ${sport.name}. Calibrated to official league height specifications of ${sportHeight} cm (${ftIn.formatted}), providing real-world perspective for athlete clearance and jumping reach.`}
      measurementAnchor="Official athletic federation regulation height standard."
    />

    <div class="grid grid-cols-2 gap-3.5 max-w-md mx-auto my-6">
      <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Regulation Height</span>
        <span class="text-2xl font-black text-slate-900 block mt-0.5">{sportHeight} cm</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Imperial Dimension</span>
        <span class="text-2xl font-black text-amber-600 block mt-0.5">{ftIn.formatted}</span>
      </div>
    </div>

    <!-- Interactive Comparison Workspace -->
    <ComparisonTool initialItems={initialItems} />

    <!-- Related Profiles via Deterministic Scoring -->
    <RelatedEntities
      entities={relatedEntities}
      title="Compare Other Sports Equipment & Benchmarks"
      subtitle={`Explore regulation targets, goals, and equipment near ${sportHeight} cm.`}
    />

    <!-- Relevant Curated Matchups -->
    {relatedComparisons.length > 0 && (
      <RelatedComparisons
        comparisons={relatedComparisons}
        title={`${sport.name} Comparisons`}
        subtitle="Compare regulation athletic dimensions against human stature."
      />
    )}

    <!-- Category Hubs -->
    <RelatedCategories
      categories={relatedCategories}
    />
  </div>
</Layout>
