---
import Layout from '../../layouts/Layout.astro';
import ComparisonTool from '../../components/ComparisonTool.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ComparisonIntro from '../../components/seo/ComparisonIntro.astro';
import RelatedPages from '../../components/seo/RelatedPages.astro';
import FAQSection from '../../components/seo/FAQSection.astro';
import { ANIMALS, type AnimalDefinition } from '../../data/animals';
import { cmToFeetInches } from '../../lib/height';
import { SITE } from '../../config/site';
import type { ComparisonItem } from '../../lib/constants';

export function getStaticPaths() {
  return ANIMALS.filter((a) => a.indexable !== false).map((animal) => ({
    params: { slug: animal.id },
    props: { animal },
  }));
}

interface Props {
  animal: AnimalDefinition;
}

const { animal } = Astro.props;
const ftIn = cmToFeetInches(animal.typicalHeightCm);
const canonical = `${SITE.siteUrl}/animal-height-comparison/${animal.id}/`;

const initialItems: ComparisonItem[] = [
  {
    id: `seo-animal-${animal.id}`,
    category: 'animal',
    name: animal.name,
    animalType: animal.id,
    heightCm: animal.typicalHeightCm,
    referenceHeightCm: animal.typicalHeightCm,
    isCustomHeight: false,
    color: '#ea580c',
  },
  {
    id: 'seo-human-ref',
    category: 'human',
    name: 'Average Human (176 cm)',
    gender: 'male',
    heightCm: 176,
    referenceHeightCm: 176,
    isCustomHeight: false,
    color: '#2563eb',
  },
];

const faqs = [
  {
    question: `How is a ${animal.name} measured?`,
    answer: animal.helpText || `A ${animal.name} is measured from the ground base to the highest anatomical point of the shoulder blades (withers).`,
  },
  {
    question: `What is the height range of a ${animal.name}?`,
    answer: `While a typical specimen measures approximately ${animal.typicalHeightCm} cm (${ftIn.formatted}), natural biological variations span from ${animal.minHeightCm} cm to ${animal.maxHeightCm} cm depending on breed, age, and sexual dimorphism.`,
  },
  {
    question: `How does a ${animal.name} compare to an average human?`,
    answer: `An average adult human stands 176 cm (5'9.3"). In comparison, a ${animal.name} stands ${animal.typicalHeightCm} cm (${ftIn.formatted}), making the human ${Math.abs(176 - animal.typicalHeightCm)} cm ${176 >= animal.typicalHeightCm ? 'taller' : 'shorter'} at shoulder height.`,
  },
];

import RelatedEntities from '../../components/seo/RelatedEntities.astro';
import RelatedComparisons from '../../components/seo/RelatedComparisons.astro';
import RelatedCategories from '../../components/seo/RelatedCategories.astro';
import {
  getRelatedEntities,
  getRelatedComparisons,
  getRelatedCategories,
} from '../../lib/internal-linking';

// Related animals via deterministic scoring
const relatedEntities = getRelatedEntities(
  {
    id: animal.id,
    category: 'animal',
    name: animal.name,
    heightCm: animal.typicalHeightCm,
    subcategory: animal.subcategory,
    tags: [animal.subcategory, animal.measurementType],
  },
  8,
  'en'
);

// Curated matchups featuring this animal
const relatedComparisons = getRelatedComparisons({
  entityId: animal.id,
  category: 'animal',
  limit: 6,
  locale: 'en',
});

// Category relationships
const relatedCategories = getRelatedCategories('animals', 3, 'en');
---

<Layout
  title={`${animal.name} Height – Height Comparison | ${SITE.name}`}
  description={`Explore verified ${animal.name} height measurements (${animal.typicalHeightCm} cm / ${ftIn.formatted}). Compare ${animal.name} to humans, predators, and objects side-by-side with HowHeight.`}
  canonicalUrl={canonical}
>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Animal Height Comparison', url: '/animal-height-comparison/' },
        { name: `${animal.name} Height`, url: `/animal-height-comparison/${animal.id}/` },
      ]}
    />

    <ComparisonIntro
      h1={`${animal.name} Height Comparison`}
      badge="Zoological Stature Reference"
      badgeColor="amber"
      introText={`Accurate physical scale comparison for ${animal.name}. In zoological and veterinary science, quadrupeds are measured from ground to withers (shoulder ridge) rather than the head to maintain skeletal consistency.`}
      measurementAnchor={animal.helpText || 'Ground to shoulder withers standard.'}
    />

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 max-w-2xl mx-auto my-6">
      <div class="p-3.5 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Typical Height</span>
        <span class="text-xl font-black text-slate-900 block mt-0.5">{animal.typicalHeightCm} cm</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Imperial</span>
        <span class="text-xl font-black text-brand-600 block mt-0.5">{ftIn.formatted}</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Min Recorded</span>
        <span class="text-xl font-black text-slate-700 block mt-0.5">{animal.minHeightCm} cm</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white border border-slate-200 shadow-soft text-center">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Max Recorded</span>
        <span class="text-xl font-black text-slate-700 block mt-0.5">{animal.maxHeightCm} cm</span>
      </div>
    </div>

    <!-- Related Profiles via Deterministic Scoring -->
    <RelatedEntities
      entities={relatedEntities}
      title="Compare Other Animal Species"
      subtitle={`Explore animal withers measurements with similar taxonomy or size near ${animal.typicalHeightCm} cm.`}
    />

    <!-- Relevant Curated Matchups -->
    {relatedComparisons.length > 0 && (
      <RelatedComparisons
        comparisons={relatedComparisons}
        title={`${animal.name} Height Comparisons`}
        subtitle="Compare verified dimensions against humans and other species."
      />
    )}

    <!-- Category Hubs -->
    <RelatedCategories
      categories={relatedCategories}
    />

    <!-- FAQs -->
    <FAQSection faqs={faqs} />
  </div>
</Layout>
