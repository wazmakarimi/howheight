---
import CategoryLanding from '../../components/CategoryLanding.astro';
import { getCategoryById } from '../../data/categories';
import { getLocaleFromUrl, type Locale } from '../../i18n';

const locale = (Astro.currentLocale as Locale) || getLocaleFromUrl(Astro.url);
const category = getCategoryById('anime')!;
---

<CategoryLanding category={category} locale={locale} />
