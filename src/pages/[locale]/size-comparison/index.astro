---
import SizeComparisonPage from '../../../components/pages/SizeComparisonPage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n/locales';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((l) => l !== 'en').map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<SizeComparisonPage locale={locale} />
