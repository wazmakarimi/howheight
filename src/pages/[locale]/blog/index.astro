---
import BlogIndexPage from '../../../components/pages/BlogIndexPage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n/locales';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((l) => l !== 'en').map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const category = Astro.url.searchParams.get('category') || undefined;
---

<BlogIndexPage locale={locale} categoryFilter={category} />
