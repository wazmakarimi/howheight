---
import CategoryLanding from '../../../components/CategoryLanding.astro';
import { CATEGORIES, type CategoryDefinition } from '../../../data/categories';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n/locales';

export function getStaticPaths() {
  const nonEnLocales = SUPPORTED_LOCALES.filter((l) => l !== 'en');
  const paths = [];

  for (const locale of nonEnLocales) {
    for (const category of CATEGORIES) {
      const categorySlug = category.route.replace(/^\/|\/$/g, '');
      paths.push({
        params: { locale, category: categorySlug },
        props: { category },
      });
    }
  }

  return paths;
}

interface Props {
  category: CategoryDefinition;
}

const { category } = Astro.props;
const { locale } = Astro.params as { locale: Locale };
---

<CategoryLanding category={category} locale={locale} />
