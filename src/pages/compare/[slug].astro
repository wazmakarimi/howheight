---
import CompareSlugPage from '../../components/pages/CompareSlugPage.astro';
import { COMPARISONS, type ComparisonDefinition } from '../../data/comparisons';
import { getLocaleFromUrl, type Locale } from '../../i18n';

export function getStaticPaths() {
  return COMPARISONS.filter((c) => c.indexable !== false).map((comp) => ({
    params: { slug: comp.slug },
    props: { comp },
  }));
}

interface Props {
  comp: ComparisonDefinition;
}

const { comp } = Astro.props;
const locale = (Astro.currentLocale as Locale) || getLocaleFromUrl(Astro.url);
---

<CompareSlugPage comp={comp} locale={locale} />
